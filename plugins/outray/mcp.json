{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "outray": {
      "type": "streamable-http",
      "url": "https://outray.co/api/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "resource": "https://outray.co/api/mcp/openai",
            "defaultScopes": ["openid", "profile", "email", "offline_access", "outray:read", "outray:write"],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
