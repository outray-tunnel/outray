# syntax=docker/dockerfile:1.7
# Explicit Ops status-only image. Never includes dashboard or tunnel runtimes.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY . .
ARG APP_PUBLIC_URL
ARG STATUS_PUBLIC_URL
ARG SHARE_PUBLIC_URL
ARG EDGE_PUBLIC_URL
ARG INGEST_PUBLIC_URL
RUN node scripts/self-hosted-artifacts.mjs verify --source /app --directory /app/.self-hosted-artifacts
# Install dependencies for the target Linux platform, never copied host modules.
# Lifecycle scripts and optional private icon authentication stay disabled.
RUN HUGEICONS_LICENSE_KEY= OUTRAY_ICON_MODE=free npm ci --ignore-scripts \
    && node scripts/self-hosted-artifacts.mjs assert-free-deps --source /app

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
LABEL com.outray.status-preview="true"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4323
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
# Preserve workspace-local production dependencies and package module types.
COPY --from=dependencies --chown=node:node /app/apps/status ./apps/status
COPY --from=dependencies --chown=node:node /app/apps/internal-check ./apps/internal-check
COPY --from=dependencies --chown=node:node /app/packages/incident-content ./packages/incident-content
# Fresh audited output overwrites only these two services and their content lib.
COPY --from=dependencies --chown=node:node /app/.self-hosted-artifacts/apps/status/dist ./apps/status/dist
COPY --from=dependencies --chown=node:node /app/.self-hosted-artifacts/apps/internal-check/dist ./apps/internal-check/dist
COPY --from=dependencies --chown=node:node /app/.self-hosted-artifacts/packages/incident-content/dist ./packages/incident-content/dist
COPY --from=dependencies --chown=node:node /app/.self-hosted-artifacts/manifest.json ./self-hosted-artifact-manifest.json
USER node
CMD ["node", "apps/status/dist/server/entry.mjs"]
