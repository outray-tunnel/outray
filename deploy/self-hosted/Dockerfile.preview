# Explicit dashboard-only trial image, NOT the full self-hosted deployment.
# Input: a fresh, source-matched, free-mode, JS-only eight-app artifact manifest.
FROM node:22-bookworm-slim AS verified
WORKDIR /app
COPY . .
ARG APP_PUBLIC_URL
ARG STATUS_PUBLIC_URL
ARG SHARE_PUBLIC_URL
ARG EDGE_PUBLIC_URL
ARG INGEST_PUBLIC_URL
RUN node scripts/self-hosted-artifacts.mjs verify --source /app --directory /app/.self-hosted-artifacts

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
LABEL com.outray.console-preview="true"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=6767
# Nitro's audited exact trace is self-contained; no root/workspace dependencies,
# source, license, package-manager config, environment file or migration runner.
COPY --from=verified --chown=node:node /app/.self-hosted-artifacts/apps/web/.output ./apps/web/.output
COPY --from=verified --chown=node:node /app/.self-hosted-artifacts/manifest.json ./self-hosted-artifact-manifest.json
USER node
CMD ["node", "apps/web/.output/server/index.mjs"]
