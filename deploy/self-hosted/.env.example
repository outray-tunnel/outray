# Generated/private values belong in root .env.self-hosted, not this template.
OUTRAY_DEPLOYMENT_MODE=self-hosted
OUTRAY_PRODUCTS=tunnels,observability,secrets,uptime
OUTRAY_APP_HOST=ops.example.com
OUTRAY_TUNNEL_DOMAIN=tunnels.ops.example.com
OUTRAY_EDGE_HOST=edge.ops.example.com
OUTRAY_INGEST_HOST=ingest.ops.example.com
OUTRAY_STATUS_HOST=status.ops.example.com
OUTRAY_SHARE_HOST=share.ops.example.com
# Compose stores status-page logos on its persistent status-page-logos volume.
# It sets STATUS_PAGE_LOGOS_DIR=/var/lib/outray/status-page-logos for web only;
# no Cloudflare delivery token is needed for self-hosting.
CADDY_EMAIL=you@example.com
OUTRAY_DOCKER_SUBNET=172.30.40.0/24
OUTRAY_CADDY_PRIVATE_IP=172.30.40.2

# Optional branch/tag for `npm run self-host:update`; unset follows this
# checkout's configured Git upstream. Updates never reset or switch branches.
# OUTRAY_UPDATE_REF=

# Existing installations can explicitly reuse their persistent Docker volumes.
# Leave unset for Compose's normal <project>_<volume> names. Never point these
# at another installation; the updater validates existing volumes before use.
# POSTGRES_VOLUME_NAME=
# REDIS_VOLUME_NAME=
# STATUS_PAGE_LOGOS_VOLUME_NAME=
# CADDY_DATA_VOLUME_NAME=
# CADDY_CONFIG_VOLUME_NAME=
# For a reviewed migration from manually created volumes, set each adopted
# volume's exact NAME above and its EXTERNAL flag to true. This allows reuse
# without Compose ownership labels and fails if the existing volume is absent.
# Keep false/unset for normal Compose-managed installations.
# POSTGRES_VOLUME_EXTERNAL=false
# REDIS_VOLUME_EXTERNAL=false
# STATUS_PAGE_LOGOS_VOLUME_EXTERNAL=false
# CADDY_DATA_VOLUME_EXTERNAL=false
# CADDY_CONFIG_VOLUME_EXTERNAL=false

# Use a separate Tinybird workspace for this installation. Never copy production credentials.
TINYBIRD_API_HOST=https://api.europe-west2.gcp.tinybird.co
TINYBIRD_INGEST_TOKEN=
TINYBIRD_QUERY_TOKEN=

# Free MIT-licensed icons are the default; no license or registry secret is needed.
# Optional own Pro credential is build-only and is never sent to application runtimes.
HUGEICONS_LICENSE_KEY=
# auto uses Pro only with a key and installed packs; free forces public icons.
# pro explicitly requires your licensed packages and fails if they are unavailable.
OUTRAY_ICON_MODE=auto

# Optional resource controls. Empty build heap preserves Node's default.
# These are not container memory limits or hardware sizing guarantees.
BUILD_NODE_MAX_OLD_SPACE_SIZE=
DASHBOARD_DB_POOL_MAX=50
REDIS_MAX_MEMORY=512mb

# Exact verified addresses are the default. Domains are an optional explicit expansion.
OUTRAY_SIGNUP_ALLOWED_EMAILS=you@example.com
OUTRAY_SIGNUP_ALLOWED_DOMAINS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Init generates independent credentials for this installation. Keep an offline key backup.
POSTGRES_USER=outray
POSTGRES_DB=outray
POSTGRES_PASSWORD=
SHARE_DATABASE_PASSWORD=
BETTER_AUTH_SECRET=
ADMIN_PASSPHRASE=
INTERNAL_API_SECRET=
STATUS_EDGE_SECRET=
UPTIME_RATE_LIMIT_SECRET=
UPTIME_UNSUBSCRIBE_SECRET=
SHARE_RATE_LIMIT_SECRET=
OUTRAY_SECRETS_ACTIVE_MASTER_KEY_ID=v1
OUTRAY_SECRETS_ACTIVE_MASTER_KEY=
OUTRAY_SECRETS_PREVIOUS_MASTER_KEYS={}

# Instance-owned per-organization quotas; no hosted plan or billing credentials needed.
OUTRAY_RETENTION_DAYS=30
OUTRAY_MAX_TUNNELS=1000
OUTRAY_MAX_DOMAINS=1000
OUTRAY_MAX_SUBDOMAINS=1000
OUTRAY_MAX_MEMBERS=1000
OUTRAY_BANDWIDTH_BYTES_PER_MONTH=1099511627776
OUTRAY_MAX_UPTIME_MONITORS=1000
OUTRAY_MAX_OBSERVABILITY_ALERTS=1000
OUTRAY_TELEMETRY_BYTES_PER_MONTH=1099511627776
OUTRAY_MAX_SECRET_VAULTS=1000
OUTRAY_MAX_SECRET_ENVIRONMENTS=1000
OUTRAY_MAX_SECRET_ENTRIES=1000000

# Only these 10 raw TCP and 10 UDP ports are exposed; expand both allocation and publish ranges together.
TCP_PORT_RANGE_MIN=20000
TCP_PORT_RANGE_MAX=20009
UDP_PORT_RANGE_MIN=30000
UDP_PORT_RANGE_MAX=30009

# The standard root/Linux lifecycle configures a dedicated probe bridge and
# proves private/metadata denial before activation. Set readiness only after
# reviewing the bridge-scoped firewall changes for your server.
UPTIME_PROBES_ENABLED=false
UPTIME_EGRESS_POLICY_READY=false
UPTIME_NOTIFICATIONS_ENABLED=false
# Optional dedicated probe network; it must not overlap any existing route.
# OUTRAY_PROBE_SUBNET=172.30.41.0/29
# OUTRAY_PROBE_ADDRESS=172.30.41.2
# OUTRAY_PROBE_GATEWAY=172.30.41.1
# OUTRAY_PROBE_BRIDGE=br-outray-prb
# OUTRAY_PROBE_RESOLVER=1.1.1.1
# Additional private infrastructure/public host ranges to deny (comma-separated).
# Host interface addresses and locally routed networks are denied automatically.
# OUTRAY_PROBE_BLOCKED_CIDRS=
ZEPTO_API_KEY=
ZEPTO_FROM_EMAIL=
ZEPTO_FROM_NAME=OutRay

# Optional Slack/Discord integrations need callback URLs on this installation.
OUTRAY_SLACK_CLIENT_ID=
OUTRAY_SLACK_CLIENT_SECRET=
OUTRAY_DISCORD_CLIENT_ID=
OUTRAY_DISCORD_CLIENT_SECRET=

# Optional console agent (your own xAI account). Omit to leave the agent unavailable.
XAI_API_KEY=
AGENT_GROK_MODEL=grok-4.7
