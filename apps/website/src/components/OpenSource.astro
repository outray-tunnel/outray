---
interface Props {
  githubUrl: string;
}

const { githubUrl } = Astro.props;
---

<section class="open-source" aria-labelledby="open-source-title">
  <div class="page-shell open-source-layout">
    <div class="open-source-topline">
      <p class="eyebrow"><span></span> Built in the open</p>
      <span>GITHUB.COM / OUTRAY-TUNNEL / OUTRAY</span>
    </div>

    <div class="open-source-main">
      <div class="open-source-intro">
        <h2 id="open-source-title">Inspect it.<br />Run it. Improve it.</h2>
        <p>
          The OutRay platform is open source and self-hostable. Read the code behind the infrastructure you depend on, and build with framework SDKs that keep integration permissive.
        </p>
        <a class="open-source-link" href={githubUrl} target="_blank" rel="noreferrer" data-track="github" data-track-label="open-source">
          Explore on GitHub
          <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
        </a>
      </div>

      <div class="open-source-repo" aria-hidden="true">
        <div class="open-source-repo__bar">
          <span class="open-source-repo__dots"><i></i><i></i><i></i></span>
          <span>github.com/outray-tunnel/outray</span>
          <svg viewBox="0 0 20 20"><path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"></path></svg>
        </div>
        <div class="open-source-repo__identity">
          <span class="open-source-repo__mark"><svg viewBox="0 0 24 24"><path d="M12 2.8a9.4 9.4 0 0 0-3 18.3c.5.1.6-.2.6-.5v-1.8c-2.6.6-3.1-1.1-3.1-1.1-.4-1.4-1-1.4-1.4-.9-.6 0-.6 0-.6 1 0 1.5 1 1.5 1 .8 1.5 2.2 1.1 2.7.9.1-.6.3-1.1.6-1.3-2.1-.2-4.3-1-4.3-4.6 0-1 .4-1.9 1-2.5-.1-.3-.4-1.2.1-2.5 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.2 2.6-1 2.6-1 .5 1.3.2 2.2.1 2.5.6.6 1 1.5 1 2.5 0 3.6-2.2 4.4-4.3 4.6.4.3.7.9.7 1.7v2.5c0 .3.2.6.7.5A9.4 9.4 0 0 0 12 2.8Z" fill="currentColor"></path></svg></span>
          <div>
            <small>PUBLIC REPOSITORY</small>
            <strong>outray-tunnel <span>/</span> outray</strong>
          </div>
        </div>
        <div class="open-source-repo__tree">
          <div><span class="open-source-repo__folder"></span><code>apps/</code><small>Platform services</small></div>
          <div><span class="open-source-repo__folder"></span><code>packages/</code><small>Framework SDKs</small></div>
          <div><span class="open-source-repo__file"></span><code>LICENSE</code><small>AGPL-3.0</small></div>
        </div>
      </div>
    </div>

    <ul class="open-source-licenses" aria-label="OutRay licenses">
      <li><span>01 / PLATFORM</span><strong>AGPL-3.0</strong><p>Source available and self-hostable.</p></li>
      <li><span>02 / FRAMEWORK SDKS</span><strong>MIT</strong><p>Permissive application integration.</p></li>
    </ul>
  </div>
</section>
