---
interface Props {
  githubUrl: string;
}

const { githubUrl } = Astro.props;
---

<section class="open-source" aria-labelledby="open-source-title">
  <div class="page-shell open-source-shell open-source-card">
    <div class="open-source-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2.8a9.4 9.4 0 0 0-3 18.3c.5.1.6-.2.6-.5v-1.8c-2.6.6-3.1-1.1-3.1-1.1-.4-1.4-1-1.4-1.4-.9-.6 0-.6 0-.6 1 0 1.5 1 1.5 1 .8 1.5 2.2 1.1 2.7.9.1-.6.3-1.1.6-1.3-2.1-.2-4.3-1-4.3-4.6 0-1 .4-1.9 1-2.5-.1-.3-.4-1.2.1-2.5 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.2 2.6-1 2.6-1 .5 1.3.2 2.2.1 2.5.6.6 1 1.5 1 2.5 0 3.6-2.2 4.4-4.3 4.6.4.3.7.9.7 1.7v2.5c0 .3.2.6.7.5A9.4 9.4 0 0 0 12 2.8Z" fill="currentColor"></path></svg>
    </div>
    <div class="open-source-copy">
      <p class="eyebrow"><span></span> Built in the open</p>
      <h2 id="open-source-title">Inspect it. Run it. Improve it.</h2>
      <p>
        The OutRay platform is available under the AGPL-3.0 license, so the infrastructure you depend on stays inspectable. Published framework SDKs use the MIT license, keeping application integration lightweight and permissive.
      </p>
      <a class="button button-secondary" href={githubUrl} target="_blank" rel="noreferrer" data-track="github" data-track-label="open-source">
        Explore the repository
        <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
      </a>
    </div>
    <div class="license-grid" role="list" aria-label="OutRay licenses">
      <div role="listitem"><small>Platform</small><strong>AGPL-3.0</strong><span>Source available and self-hostable</span></div>
      <div role="listitem"><small>Framework SDKs</small><strong>MIT</strong><span>Permissive application integration</span></div>
    </div>
  </div>
</section>
