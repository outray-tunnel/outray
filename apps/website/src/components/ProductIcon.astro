---

<svg
  class:list={["product-icon", className]}
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <g class="product-icon__stroke" fill="none" stroke="currentColor" stroke-width="1.7">
    {icon.stroke.map((path) => (
      <path
        d={path.d}
        stroke-linecap={path.linecap}
        stroke-linejoin={path.linejoin}
      />
    ))}
  </g>
  <g class="product-icon__solid" fill="currentColor">
    <path d={icon.solid} fill-rule="evenodd" clip-rule="evenodd" />
  </g>
</svg>

<style>
  .product-icon__solid {
    display: none;
  }

  :global([aria-selected="true"]) .product-icon__stroke {
    display: none;
  }

  :global([aria-selected="true"]) .product-icon__solid {
    display: inline;
  }
</style>
