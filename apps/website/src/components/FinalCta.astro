---
interface Props {
  signupUrl: string;
  githubUrl: string;
}

const { signupUrl, githubUrl } = Astro.props;
---

<section class="relative isolate overflow-hidden py-[clamp(108px,14vw,190px)] text-center before:absolute before:top-1/2 before:left-1/2 before:-z-[1] before:h-[520px] before:w-[min(850px,90vw)] before:-translate-x-1/2 before:-translate-y-1/2 before:bg-[radial-gradient(ellipse,rgb(131_103_199_/_0.15),transparent_68%)] before:content-['']" aria-labelledby="final-cta-title">
  <div class="absolute inset-0 -z-[2] bg-[linear-gradient(rgb(255_255_255_/_0.028)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255_/_0.028)_1px,transparent_1px)] bg-[size:54px_54px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_67%)]" aria-hidden="true"></div>
  <div class="mx-auto w-[min(calc(100%-48px),var(--container-page))] text-center max-[1080px]:w-[min(calc(100%-36px),var(--container-page))] max-[860px]:w-[min(calc(100%-28px),var(--container-page))] max-[620px]:w-[min(calc(100%-24px),var(--container-page))]">
    <img class="mx-auto mb-6 h-12 w-12 drop-shadow-[0_0_22px_rgb(131_103_199_/_0.4)]" src="/brand/outray-mark.svg" width="48" height="48" alt="" loading="lazy" />
    <p class="inline-flex items-center justify-center gap-[9px] text-[.74rem] leading-[1.1] font-bold tracking-[.15em] text-accent-light uppercase"><span class="h-px w-[18px] bg-current"></span> Start where your service is</p>
    <h2 class="mx-auto max-w-[900px] text-[clamp(3.15rem,8vw,7.75rem)] leading-[.88] font-[570] tracking-[-.072em]" id="final-cta-title">Your next request should tell you more.</h2>
    <p class="mx-auto mt-[30px] max-w-[590px] text-[clamp(1rem,1.6vw,1.18rem)] leading-[1.65] text-muted">Open a tunnel, capture a trace, or inject a vault. OutRay is ready when your service is.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-2.5 max-[620px]:grid max-[620px]:grid-cols-1">
      <a class="relative inline-flex min-h-[46px] items-center justify-center gap-[9px] overflow-hidden rounded-[14px] border border-white/90 bg-white px-[19px] text-[.94rem] font-[620] tracking-[-.015em] text-[#080808] shadow-[0_10px_30px_rgb(255_255_255_/.08)] transition-[border-color,background-color,color,transform,box-shadow] duration-200 ease-snappy hover:-translate-y-px hover:border-white hover:bg-[#f1eff7] hover:shadow-[0_12px_36px_rgb(131_103_199_/.18)] max-[620px]:w-full" href={signupUrl} data-track="cta" data-track-label="final-start-free">Start free</a>
      <a class="relative inline-flex min-h-[46px] items-center justify-center gap-[9px] overflow-hidden rounded-[14px] border border-line-strong bg-[#111113] px-[19px] text-[.94rem] font-[620] tracking-[-.015em] text-ink transition-[border-color,background-color,color,transform,box-shadow] duration-200 ease-snappy hover:-translate-y-px hover:border-white/30 hover:bg-[#18181b] max-[620px]:w-full" href={githubUrl} target="_blank" rel="noreferrer" data-track="github" data-track-label="final">View on GitHub</a>
    </div>
  </div>
</section>
