---
import GitHubIcon from "./GitHubIcon.astro";

interface Props {
  signupUrl: string;
  githubUrl: string;
}

const { signupUrl, githubUrl } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="page-shell hero-content hero-shell">
    <h1 class="hero-title" id="hero-title">Everything between <span class="hero-endpoint hero-endpoint-local">localhost</span> and <span class="hero-endpoint hero-endpoint-production">production</span></h1>
    <p class="hero-lede">
      Secure tunnels, server-side observability, and encrypted runtime secrets in one developer platform.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={signupUrl} data-track="cta" data-track-label="hero-start-free">
        Start free
        <svg aria-hidden="true" viewBox="0 0 20 20"><path d="m7 4 6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"></path></svg>
      </a>
      <a class="button button-secondary" href={githubUrl} target="_blank" rel="noreferrer" data-track="github" data-track-label="hero">
        <GitHubIcon />
        GitHub
      </a>
    </div>

  </div>

</section>
