  {
    "id": "welcome",
    "name": "Welcome Email",
    "group": "Account",
    "subject": "Welcome to Outray!",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Welcome to Outray</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi John Doe,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                I'm Akinkunmi, the creator of OutRay. I'm happy to have you onboard! <br/> <br/> OutRay makes it easy to expose your local development servers to the internet securely.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Get started by installing the CLI and creating your first tunnel.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <a href=\"https://outray.dev/select\" style=\"display: inline-block; padding: 14px 32px; background-color: #18181b; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                Go to Dashboard\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                If you have any questions or feedback, just reply to this email – I personally read every one.\n              </p>\n              <p style=\"margin: 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Cheers,<br>\n                Akinkunmi\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Connected to sender"
  },
  {
    "id": "organization-invite",
    "name": "Organization Invite",
    "group": "Account",
    "subject": "You're invited to join Acme Corp on OutRay",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>You're Invited to Join Acme Corp</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <h1 style=\"margin: 0 0 20px 0; font-size: 28px; font-weight: 700; color: #18181b;\">You're Invited! 🎉</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                <strong>Jane Smith</strong> has invited you to join the organization <strong>Acme Corp</strong> on OutRay with the role of <strong>member</strong>.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Click the button below to accept the invitation and get started.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <a href=\"https://outray.dev/invitations/accept?token=abc123\" style=\"display: inline-block; padding: 14px 32px; background-color: #18181b; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                Accept Invitation\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                Or copy and paste this link into your browser:<br>\n                <a href=\"https://outray.dev/invitations/accept?token=abc123\" style=\"color: #2563eb; word-break: break-all;\">https://outray.dev/invitations/accept?token=abc123</a>\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                If you did not expect this invitation, you can safely ignore this email.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Connected to sender"
  },
  {
    "id": "password-reset",
    "name": "Password Reset",
    "group": "Account",
    "subject": "Reset Your Password",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Reset Your Password</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <h1 style=\"margin: 0 0 20px 0; font-size: 28px; font-weight: 700; color: #18181b;\">Reset Your Password 🔐</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi John Doe,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                We received a request to reset your password. Click the button below to create a new password.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                This link will expire in 1 hour. If you didn't request this, you can safely ignore this email.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <a href=\"https://outray.dev/reset-password?token=abc123\" style=\"display: inline-block; padding: 14px 32px; background-color: #dc2626; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                Reset Password\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                Or copy and paste this link into your browser:<br>\n                <a href=\"https://outray.dev/reset-password?token=abc123\" style=\"color: #2563eb; word-break: break-all;\">https://outray.dev/reset-password?token=abc123</a>\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Template only"
  },
  {
    "id": "payment-failed",
    "name": "Payment Failed",
    "group": "Billing",
    "subject": "Action Required: Your OutRay payment failed",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Payment Failed</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <h1 style=\"margin: 0 0 20px 0; font-size: 28px; font-weight: 700; color: #dc2626;\">Payment Failed ⚠️</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi John Doe,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                We couldn't process your payment of <strong>₦21,000</strong> for the <strong>Beam</strong> plan on OutRay.\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                We'll retry your payment automatically. You have <strong>2 attempts</strong> remaining before your subscription is cancelled.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                To update your payment method, visit your billing page:\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <a href=\"https://outray.dev/acme/billing\" style=\"display: inline-block; padding: 14px 32px; background-color: #18181b; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                Update Payment Method\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                Common reasons for payment failures include:\n              </p>\n              <ul style=\"margin: 10px 0; padding-left: 20px; font-size: 14px; line-height: 24px; color: #71717a;\">\n                <li>Insufficient funds</li>\n                <li>Expired card</li>\n                <li>Card declined by your bank</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                If you have any questions, just reply to this email.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Template only"
  },
  {
    "id": "subscription-reset",
    "name": "Subscription Reset",
    "group": "Billing",
    "subject": "Your Acme Inc subscription has been reset",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Subscription Reset</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi John Doe,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Your organization <strong>Acme Inc</strong> has been reset from the <strong>Ray</strong> plan to the <strong>Free</strong> plan.\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                As part of this change, the following adjustments were made to fit within the Free plan limits:\n              </p>\n              <ul style=\"margin: 0 0 24px 0; padding-left: 20px; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                <li>Custom domains have been removed</li>\n                <li>Reserved subdomains reduced to 1</li>\n                <li>Tunnels reduced to 2</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <a href=\"https://outray.dev/acme/settings\" style=\"display: inline-block; padding: 14px 32px; background-color: #18181b; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                View Dashboard\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                If you believe this was done in error or have any questions, please reply to this email.\n              </p>\n              <p style=\"margin: 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Thanks,<br>\n                The OutRay Team\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Connected to sender"
  },
  {
    "id": "payment-failed-final",
    "name": "Payment failed · final attempt",
    "group": "Billing",
    "subject": "Action Required: Your OutRay payment failed",
    "html": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Payment Failed</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #ffffff; padding: 40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width: 600px;\">\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <h1 style=\"margin: 0 0 20px 0; font-size: 28px; font-weight: 700; color: #dc2626;\">Payment Failed ⚠️</h1>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                Hi John Doe,\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                We couldn't process your payment of <strong>₦21,000</strong> for the <strong>Beam</strong> plan on OutRay.\n              </p>\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                This was our final attempt. Your subscription has been cancelled and downgraded to the free plan.\n              </p>\n              <p style=\"margin: 0 0 24px 0; font-size: 16px; line-height: 24px; color: #3f3f46;\">\n                To update your payment method, visit your billing page:\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 20px 0;\">\n              <a href=\"https://outray.dev/acme/billing\" style=\"display: inline-block; padding: 14px 32px; background-color: #18181b; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: 600; border-radius: 8px;\">\n                Update Payment Method\n              </a>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                Common reasons for payment failures include:\n              </p>\n              <ul style=\"margin: 10px 0; padding-left: 20px; font-size: 14px; line-height: 24px; color: #71717a;\">\n                <li>Insufficient funds</li>\n                <li>Expired card</li>\n                <li>Card declined by your bank</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 0 30px 0;\">\n              <p style=\"margin: 0; font-size: 14px; line-height: 20px; color: #71717a;\">\n                If you have any questions, just reply to this email.\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 20px 0 0 0; border-top: 1px solid #e4e4e7;\">\n              <p style=\"margin: 0; font-size: 14px; color: #71717a;\">\n                © 2026 Outray. All rights reserved.\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
    "source": "apps/web/src/email/templates.ts",
    "usage": "Template only"
  },
