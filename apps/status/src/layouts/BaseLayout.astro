---
interface Props {
  title: string;
  description?: string;
  accent?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description = "Live service status and incident updates.", accent = "#8367c7", canonical, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <style define:vars={{ accent }}>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #09090b; color: #f4f4f5; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; background: radial-gradient(circle at 50% -14%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 38%), #09090b; }
      button, input { font: inherit; }
      button { cursor: pointer; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .shell { width: min(100% - 40px, 920px); margin-inline: auto; }
      .footer { border-top: 1px solid #26262b; padding: 24px 0 48px; color: #85858f; font-size: 13px; }
      .footer .shell { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
      .footer a { text-decoration: none; }
      .footer a:hover { color: #f4f4f5; }
      @media (max-width: 600px) { .shell { width: min(100% - 28px, 920px); } }
    </style>
  </head>
  <body>
    <slot />
    <footer class="footer">
      <div class="shell"><span>Powered by <a href="https://outray.co" target="_blank" rel="noopener noreferrer">OutRay</a></span><span>Public status</span></div>
    </footer>
  </body>
</html>
