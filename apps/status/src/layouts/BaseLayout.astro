---
interface Props {
  title: string;
  description?: string;
  accent?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description = "Live service status and incident updates.", accent = "#8367c7", canonical, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <style is:global define:vars={{ accent }}>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #09090b; color: #f4f4f5; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; background: #09090b; }
      button, input { font: inherit; }
      button { cursor: pointer; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .shell { width: min(100% - 48px, 800px); margin-inline: auto; }
      .footer { border-top: 1px solid #27272a; padding: 24px 0 40px; color: #a1a1aa; font-size: 13px; }
      .footer .shell { display: flex; justify-content: center; align-items: center; }
      .footer a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: #e4e4e7; }
      .footer a span { color: #a1a1aa; }
      .footer a strong { font-weight: 650; }
      .footer img { display: block; width: 18px; height: 18px; }
      .footer a:hover { color: #f4f4f5; }
      @media (max-width: 600px) { .shell { width: min(100% - 32px, 800px); } }
    </style>
  </head>
  <body>
    <slot />
    <footer class="footer">
      <div class="shell"><a href="https://outray.co" target="_blank" rel="noopener noreferrer"><span>Powered by</span><img src="/outray-mark.svg" alt="" /><strong>OutRay</strong></a></div>
    </footer>
  </body>
</html>
