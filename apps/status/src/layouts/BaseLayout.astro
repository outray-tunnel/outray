---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  accent?: string;
  canonical?: string;
  noindex?: boolean;
  faviconUrl?: string | null;
}

const { title, description = "Live service status and incident updates.", accent = "#8367c7", canonical, noindex = false, faviconUrl } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-[#09090b] font-sans text-[#f4f4f5] [color-scheme:dark]" style={`--accent: ${accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href={faviconUrl || "/outray-mark.svg"} />
    <link rel="preload" href="/fonts/geom-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body class="m-0 min-w-80 bg-[#09090b] [&_button]:cursor-pointer [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-[3px] [&_:focus-visible]:outline-[var(--accent)]">
    <slot />
    <footer class="border-t border-[#27272a] pt-6 pb-10 text-[13px] text-[#a1a1aa]">
      <div class="mx-auto flex w-[min(100%_-_48px,800px)] items-center justify-center max-[600px]:w-[min(100%_-_32px,800px)]">
        <a class="inline-flex items-center gap-2 text-[#e4e4e7] no-underline hover:text-[#f4f4f5]" href="https://outray.co" target="_blank" rel="noopener noreferrer">
          <span class="text-[#a1a1aa]">Powered by</span><img class="block size-[18px]" src="/outray-mark.svg" alt="" /><strong class="font-[650]">OutRay</strong>
        </a>
      </div>
    </footer>
  </body>
</html>
