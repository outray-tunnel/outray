---
import BaseLayout from "../layouts/BaseLayout.astro";
import { inspectUnsubscribe, maskEmail } from "../lib/subscriptions";

Astro.response.headers.set("Cache-Control", "no-store");
const token = Astro.url.searchParams.get("token") || "";
const subscription = await inspectUnsubscribe(token);
Astro.response.status = subscription ? 200 : 404;
---
<BaseLayout title="Unsubscribe from status updates" noindex><main class="shell card"><p class="eyebrow">EMAIL PREFERENCES</p>{subscription ? <><h1>Unsubscribe?</h1><p>Stop sending {subscription.name} incident updates to <strong>{maskEmail(subscription.email)}</strong>.</p><form method="post" action="/api/unsubscribe"><input type="hidden" name="token" value={token} /><button type="submit">Unsubscribe</button></form></> : <><h1>Link unavailable</h1><p>This link has expired or the subscription is no longer active.</p></>}</main><style>.card{min-height:70vh;padding-top:clamp(70px,12vw,140px);max-width:620px}.eyebrow{font-size:11px;letter-spacing:.15em;color:#a78bfa;font-weight:700}h1{font-size:clamp(34px,6vw,50px);letter-spacing:-.05em;margin:10px 0 18px}p{line-height:1.7;color:#a1a1aa}strong{color:white}button{margin-top:20px;padding:13px 20px;background:#fff;border:0;border-radius:10px;color:#09090b;font-weight:700}</style></BaseLayout>
