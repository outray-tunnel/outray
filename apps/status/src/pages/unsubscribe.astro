---
import BaseLayout from "../layouts/BaseLayout.astro";
import { inspectUnsubscribe, maskEmail } from "../lib/subscriptions";

Astro.response.headers.set("Cache-Control", "no-store");
const token = Astro.url.searchParams.get("token") || "";
const subscription = await inspectUnsubscribe(token);
Astro.response.status = subscription ? 200 : 404;
---
<BaseLayout title="Unsubscribe from status updates" noindex><main class="mx-auto min-h-[70vh] w-[min(100%_-_48px,620px)] pt-[clamp(70px,12vw,140px)] max-[600px]:w-[min(100%_-_32px,620px)]"><p class="my-[1em] text-[11px] leading-[1.7] font-bold tracking-[0.15em] text-[#a78bfa]">EMAIL PREFERENCES</p>{subscription ? <><h1 class="mt-[10px] mb-[18px] text-[clamp(34px,6vw,50px)] font-bold tracking-[-0.05em]">Unsubscribe?</h1><p class="my-[1em] leading-[1.7] text-[#a1a1aa]">Stop sending {subscription.name} incident updates to <strong class="text-white">{maskEmail(subscription.email)}</strong>.</p><form method="post" action="/api/unsubscribe"><input type="hidden" name="token" value={token} /><button class="mt-5 rounded-[10px] border-0 bg-white px-5 py-[13px] font-bold text-[#09090b]" type="submit">Unsubscribe</button></form></> : <><h1 class="mt-[10px] mb-[18px] text-[clamp(34px,6vw,50px)] font-bold tracking-[-0.05em]">Link unavailable</h1><p class="my-[1em] leading-[1.7] text-[#a1a1aa]">This link has expired or the subscription is no longer active.</p></>}</main></BaseLayout>
