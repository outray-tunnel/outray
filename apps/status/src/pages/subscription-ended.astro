---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.headers.set("Cache-Control", "no-store");
---
<BaseLayout title="Unsubscribed" noindex><main class="mx-auto min-h-[70vh] w-[min(100%_-_48px,800px)] pt-[clamp(70px,12vw,140px)] max-[600px]:w-[min(100%_-_32px,800px)]"><p class="my-[1em] text-[11px] font-bold tracking-[0.15em] text-[#6ee7b7]">UNSUBSCRIBED</p><h1 class="mt-[10px] mb-[18px] text-[clamp(34px,6vw,50px)] font-bold tracking-[-0.05em]">You're unsubscribed.</h1><p class="my-[1em] text-[#a1a1aa]">You won't receive further status email for this page.</p></main></BaseLayout>
