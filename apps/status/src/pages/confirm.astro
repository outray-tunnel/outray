---
import BaseLayout from "../layouts/BaseLayout.astro";
import { inspectConfirmation, maskEmail } from "../lib/subscriptions";

Astro.response.headers.set("Cache-Control", "no-store");
const token = Astro.url.searchParams.get("token") || "";
const subscription = await inspectConfirmation(token);
Astro.response.status = subscription ? 200 : 404;
---
<BaseLayout title="Confirm status updates" noindex>
  <main class="mx-auto min-h-[70vh] w-[min(100%_-_48px,620px)] pt-[clamp(70px,12vw,140px)] max-[600px]:w-[min(100%_-_32px,620px)]"><p class="my-[1em] text-[11px] leading-[1.7] font-bold tracking-[0.15em] text-[#a78bfa]">EMAIL CONFIRMATION</p>{subscription ? <><h1 class="mt-[10px] mb-[18px] text-[clamp(34px,6vw,50px)] font-bold tracking-[-0.05em]">One last step</h1><p class="my-[1em] leading-[1.7] text-[#a1a1aa]">Confirm <strong class="text-white">{maskEmail(subscription.email)}</strong> to receive team-published incident updates from {subscription.name}.</p><form method="post" action="/api/confirm"><input type="hidden" name="token" value={token} /><button class="mt-5 rounded-[10px] border-0 bg-[#8367c7] px-5 py-[13px] font-bold text-white" type="submit">Confirm subscription</button></form></> : <><h1 class="mt-[10px] mb-[18px] text-[clamp(34px,6vw,50px)] font-bold tracking-[-0.05em]">Link unavailable</h1><p class="my-[1em] leading-[1.7] text-[#a1a1aa]">This link may have expired or already been used, or subscriptions are currently turned off. When subscriptions are available, you can sign up again from the status page.</p></>}</main>
</BaseLayout>
