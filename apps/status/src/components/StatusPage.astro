---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getStatusConfig } from "../lib/config";
import type { PublicState, PublicStatusPage } from "../lib/status-data";

interface Props { page: PublicStatusPage; subscribed?: boolean; }
const { page, subscribed = false } = Astro.props;
const subscriptionsEnabled = Boolean(getStatusConfig().zeptoApiKey);
const stateCopy: Record<PublicState, string> = {
  operational: "All systems operational",
  degraded: "Some services degraded",
  outage: "Service outage",
  unknown: "Current status unknown",
};
const stateLabel: Record<PublicState, string> = {
  operational: "Operational",
  degraded: "Degraded",
  outage: "Outage",
  unknown: "Unknown",
};
const formatDate = (date: Date | null) => date
  ? new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(date) + " UTC"
  : "Not yet updated";
const uptime = page.observedUptime === null ? "—" : `${page.observedUptime.toFixed(2)}%`;
const latency = page.averageLatencyMs === null ? "—" : `${Math.round(page.averageLatencyMs)} ms`;
---
<BaseLayout title={`${page.name} status`} description={page.description || `Current status and incident history for ${page.name}.`} accent={page.accentColor} canonical={page.canonicalUrl}>
  <main class="shell main">
    <header class="header">
      <div class="brand">
        {page.logoUrl ? <img class="logo" src={page.logoUrl} alt="" width="48" height="48" /> : <div class="logo fallback" aria-hidden="true">{page.name.slice(0, 1).toUpperCase()}</div>}
        <div><p class="eyebrow">STATUS PAGE</p><h1>{page.name}</h1></div>
      </div>
      {page.description && <p class="description">{page.description}</p>}
    </header>

    <section class:list={["overall", page.state]} aria-labelledby="overall-heading" aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <div><p class="eyebrow">CURRENT STATUS</p><h2 id="overall-heading">{stateCopy[page.state]}</h2></div>
      <span class="overall-time">Published states and live checks</span>
    </section>

    <div class="metrics" aria-label="Observed results over the last 30 days">
      <div><span>Observed uptime</span><strong>{uptime}</strong></div>
      <div><span>Average response</span><strong>{latency}</strong></div>
      <div><span>Checks observed</span><strong>{page.checkCount.toLocaleString()}</strong></div>
    </div>
    <p class="metric-note">Based only on completed checks in the past 30 days. An unknown status is not counted as operational.</p>

    <section class="section" aria-labelledby="components-heading">
      <div class="section-heading"><div><p class="eyebrow">SERVICES</p><h2 id="components-heading">Components</h2></div><span>{page.groups.reduce((count, group) => count + group.components.length, 0)} visible</span></div>
      {page.groups.length === 0 ? <div class="empty">No components have been published yet.</div> : page.groups.map((group) => (
        <div class="group">
          <div class="group-heading"><h3>{group.name}</h3><span class:list={["state", group.state]}><span class="status-dot" aria-hidden="true"></span>{stateLabel[group.state]}</span></div>
          {group.components.length === 0 ? <p class="empty group-empty">No visible components in this group.</p> : group.components.map((component) => (
            <div class="component">
              <div class="component-copy"><strong>{component.name}</strong>{component.description && <p>{component.description}</p>}{component.manual && <small>{formatDate(component.updatedAt)}</small>}</div>
              <span class:list={["state", component.state]}><span class="status-dot" aria-hidden="true"></span>{stateLabel[component.state]}</span>
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="section" aria-labelledby="incidents-heading">
      <div class="section-heading"><div><p class="eyebrow">HISTORY</p><h2 id="incidents-heading">Recent incidents</h2></div><span>Latest 25</span></div>
      {page.incidents.length === 0 ? <div class="empty">No incidents to show.</div> : <ol class="incidents">{page.incidents.map((incident) => (
        <li class="incident">
          <span class:list={["incident-marker", incident.status]} aria-hidden="true"></span>
          <div><div class="incident-heading"><strong>{incident.title}</strong><span class:list={["incident-state", incident.status]}>{incident.status === "resolved" ? "Resolved" : "Investigating"}</span></div>
            {incident.components.length > 0 && <p class="incident-components">Affects {incident.components.join(", ")}</p>}
            {incident.latestNote && <p class="incident-note">{incident.latestNote}</p>}
            <time datetime={incident.startedAt.toISOString()}>{formatDate(incident.startedAt)}</time>
            {incident.updates.length > 0 && <details class="updates"><summary>View {incident.updates.length} published {incident.updates.length === 1 ? "update" : "updates"}</summary><ol>{incident.updates.map((update) => <li><div><strong>{update.status}</strong><time datetime={update.publishedAt.toISOString()}>{formatDate(update.publishedAt)}</time></div><p>{update.note}</p></li>)}</ol></details>}
          </div>
        </li>
      ))}</ol>}
    </section>

    <section class="subscribe section" aria-labelledby="subscribe-heading">
      <div><p class="eyebrow">STAY INFORMED</p><h2 id="subscribe-heading">Get incident updates</h2><p>Subscribe for team-published incident updates. Automatic health changes appear above but do not send subscriber email.</p></div>
      {subscriptionsEnabled ? <form method="post" action="/api/subscribe">
        <label for="subscription-email">Email address</label>
        <div class="form-row"><input id="subscription-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required /><button type="submit">Subscribe</button></div>
        <input type="hidden" name="pageId" value={page.id} />
        <small>{subscribed ? "If this address is not already subscribed, check your inbox to confirm it." : "Confirm your email before updates begin. Unsubscribe at any time."}</small>
      </form> : <p class="subscriptions-unavailable">Email subscriptions are temporarily unavailable. Current status and incidents remain visible here.</p>}
    </section>
  </main>
  <style>
    .main { padding-top: clamp(44px, 8vw, 80px); padding-bottom: 100px; }
    .header { margin-bottom: 42px; }
    .brand { display: flex; gap: 18px; align-items: center; }
    .logo { width: 48px; height: 48px; object-fit: cover; border-radius: 12px; background: #18181b; }
    .fallback { display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 25%, #151519); font-size: 25px; font-weight: 750; }
    .eyebrow { margin: 0 0 7px; color: #85858f; font-size: 11px; font-weight: 700; letter-spacing: .15em; }
    h1,h2,h3,p { margin-top: 0; }
    h1 { margin-bottom: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.1; letter-spacing: -.04em; }
    .description { color: #a1a1aa; margin: 16px 0 0 66px; line-height: 1.6; max-width: 62ch; }
    .overall { display: flex; align-items: center; gap: 16px; border: 1px solid #303035; background: #151518; border-radius: 18px; padding: 25px 28px; }
    .overall.operational { border-color: #155e48; background: linear-gradient(110deg,#10241d,#121518 65%); }
    .overall.degraded { border-color: #846327; background: linear-gradient(110deg,#292114,#151518 65%); }
    .overall.outage { border-color: #8f3343; background: linear-gradient(110deg,#2c161c,#151518 65%); }
    .overall h2 { font-size: clamp(18px, 3vw, 23px); margin: 0; line-height: 1.3; }
    .overall .eyebrow { margin-bottom: 3px; }
    .status-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: #92929c; box-shadow: 0 0 0 4px #a1a1aa1a; }
    .operational .status-dot { background: #34d399; box-shadow: 0 0 0 4px #34d39922; }
    .degraded .status-dot { background: #fbbf24; box-shadow: 0 0 0 4px #fbbf2422; }
    .outage .status-dot { background: #fb7185; box-shadow: 0 0 0 4px #fb718522; }
    .overall-time { color: #888891; font-size: 12px; margin-left: auto; }
    .metrics { display: grid; grid-template-columns: repeat(3,1fr); border: 1px solid #28282e; border-radius: 16px; margin-top: 16px; overflow: hidden; }
    .metrics>div { display: flex; flex-direction: column; gap: 8px; padding: 20px 24px; }
    .metrics>div+div { border-left: 1px solid #28282e; }
    .metrics span { font-size: 12px; color: #92929c; }
    .metrics strong { font-size: 21px; font-weight: 650; font-variant-numeric: tabular-nums; }
    .metric-note { font-size: 12px; color: #777780; margin: 12px 0 0; }
    .section { margin-top: 62px; }
    .section-heading { display:flex; justify-content:space-between; align-items:end; gap:16px; margin-bottom:18px; }
    .section-heading h2,.subscribe h2 { margin:0; font-size:24px; letter-spacing:-.035em; }
    .section-heading>span { color:#777780; font-size:12px; }
    .group { border:1px solid #2b2b31; border-radius:16px; overflow:hidden; margin-bottom:14px; background:#101012; }
    .group-heading,.component { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:19px 24px; }
    .group-heading { border-bottom:1px solid #28282d; background:#151518; }
    .group-heading h3 { margin:0; font-size:15px; }
    .component+.component { border-top:1px solid #26262a; }
    .component-copy strong { font-size:14px; font-weight:600; }
    .component-copy p { margin:5px 0 0; color:#9999a2; font-size:13px; line-height:1.5; }
    .component-copy small { display:block; color:#71717a; margin-top:7px; font-size:11px; }
    .state { display:inline-flex; align-items:center; gap:9px; white-space:nowrap; font-size:12px; color:#a1a1aa; }
    .state.operational { color:#6ee7b7; }.state.degraded { color:#fcd34d; }.state.outage { color:#fda4af; }
    .state .status-dot { width:7px; height:7px; box-shadow:none; }
    .empty { padding:26px; color:#85858f; border:1px solid #2b2b31; border-radius:16px; font-size:13px; }
    .group-empty { border:0; border-radius:0; margin:0; }
    .incidents { padding:0; margin:0; list-style:none; border:1px solid #2b2b31; border-radius:16px; background:#101012; overflow:hidden; }
    .incident { display:grid; grid-template-columns:9px 1fr; gap:17px; padding:22px 24px; }
    .incident+.incident { border-top:1px solid #28282d; }
    .incident-marker { width:9px; height:9px; border-radius:50%; margin-top:5px; background:#fb7185; }.incident-marker.resolved { background:#34d399; }
    .incident-heading { display:flex; align-items:center; flex-wrap:wrap; gap:12px; }.incident-heading strong { font-size:14px; }
    .incident-state { border:1px solid #673943; color:#fda4af; border-radius:99px; padding:3px 8px; font-size:11px; }.incident-state.resolved { border-color:#315e4a; color:#6ee7b7; }
    .incident-components,.incident-note { color:#a1a1aa; font-size:13px; line-height:1.55; margin:8px 0 0; }
    .incident-note { color:#d4d4d8; white-space:pre-wrap; }
    .incident time { display:block; color:#777780; font-size:11px; margin-top:10px; }
    .updates { margin-top:15px; }.updates summary { color:#c4b5fd; font-size:12px; cursor:pointer; width:max-content; }.updates ol { border-left:1px solid #36303f; padding:0 0 0 20px; margin:15px 0 0; list-style:none; }.updates li+li { margin-top:18px; }.updates li div { display:flex; gap:12px; align-items:baseline; flex-wrap:wrap; }.updates li strong { color:#d4d4d8; font-size:12px; font-weight:600; text-transform:capitalize; }.updates li time { display:inline; margin:0; }.updates li p { margin:7px 0 0; color:#a1a1aa; white-space:pre-wrap; font-size:13px; line-height:1.55; }
    .subscribe { display:grid; grid-template-columns:1fr 1.05fr; gap:40px; padding:30px; border:1px solid #39313e; border-radius:18px; background:linear-gradient(130deg,#19151f,#111114 64%); }
    .subscribe p:last-child { margin:12px 0 0; color:#a1a1aa; font-size:13px; line-height:1.6; }
    .subscribe form { display:flex; flex-direction:column; justify-content:center; gap:8px; }
    .subscribe label { font-size:12px; font-weight:600; }.form-row { display:flex; gap:9px; }
    .subscribe input[type=email] { min-width:0; flex:1; padding:11px 12px; border:1px solid #424149; border-radius:10px; background:#0c0c0e; color:#fff; font-size:13px; }
    .subscribe button { flex:none; border:0; border-radius:10px; background:var(--accent); color:#fff; padding:11px 14px; font-size:12px; font-weight:700; }
    .subscribe button:hover { filter:brightness(1.16); }.subscribe small { font-size:11px; color:#898991; line-height:1.5; }
    .subscriptions-unavailable { align-self:center; color:#a1a1aa; font-size:13px; line-height:1.6; }
    @media(max-width:650px) { .overall { padding:21px; }.overall-time { display:none; }.metrics>div { padding:16px; }.metrics strong { font-size:17px; }.subscribe { grid-template-columns:1fr; gap:24px; padding:22px; }.description { margin-left:0; } }
    @media(max-width:450px) { .metrics { grid-template-columns:1fr 1fr; }.metrics>div:last-child { grid-column:1/-1; border-top:1px solid #28282e; border-left:0; }.group-heading,.component { padding:16px; }.form-row { flex-direction:column; }.subscribe button { width:100%; min-height:42px; } }
  </style>
</BaseLayout>
