---
import BaseLayout from "../layouts/BaseLayout.astro";
import Analytics from "./Analytics.astro";
import ComponentHistoryChart from "./ComponentHistoryChart";
import GetUpdates from "./GetUpdates";
import { getStatusConfig } from "../lib/config";
import { formatDuration } from "../lib/format-duration";
import { publishedIncidentStage, type PublicIncident, type PublicState, type PublicStatusPage } from "../lib/status-data";
import { renderIncidentHtml } from "@outray/incident-content";

interface Props { page: PublicStatusPage; subscribed?: boolean; }
const { page, subscribed = false } = Astro.props;
const subscriptionConfig = getStatusConfig();
const subscriptionsEnabled = page.subscriptionsEnabled && Boolean(subscriptionConfig.zeptoApiKey && subscriptionConfig.fromEmail);
const stateCopy: Record<PublicState, string> = {
  operational: "All systems operational",
  degraded: "Some services degraded",
  outage: "Service outage",
  unknown: "Current status unknown",
};
const stateLabel: Record<PublicState, string> = {
  operational: "Operational",
  degraded: "Degraded",
  outage: "Outage",
  unknown: "Unknown",
};
const formatDate = (date: Date | null) => date
  ? new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(date) + " UTC"
  : "Not yet updated";
const showStatusSuffix = !/\bstatus$/i.test(page.name.trim());
const localSlugPath = Astro.url.pathname === `/${page.slug}` || Astro.url.pathname === `/${page.slug}/`;
const incidentBasePath = localSlugPath ? `/${page.slug}/incidents` : "/incidents";
const activeIncidents = page.incidents.filter((incident) => incident.status === "open");
const pastIncidents = page.incidents.filter((incident) => incident.status === "resolved");
const currentState: PublicState = activeIncidents.length > 0 && (page.state === "operational" || page.state === "unknown") ? "degraded" : page.state;
const hasIssues = activeIncidents.length > 0 || currentState === "degraded" || currentState === "outage";
const affectedComponents = [...new Set(activeIncidents.length > 0
  ? activeIncidents.flatMap((incident) => incident.components)
  : [...page.standaloneComponents, ...page.groups.flatMap((group) => group.components)]
    .filter((component) => component.state === "degraded" || component.state === "outage")
    .map((component) => component.name))];
const incidentStage = (incident: PublicIncident) => {
  const status = publishedIncidentStage(incident);
  return status.replaceAll("_", " ").replace(/^./, (letter) => letter.toUpperCase());
};
const ongoingFor = (startedAt: Date) => `Ongoing for ${formatDuration(Math.max(1, Math.floor((Date.now() - startedAt.getTime()) / 60_000)))}`;
const rootItems = [
  ...page.standaloneComponents.map((component) => ({ kind: "component" as const, component, sortOrder: component.sortOrder })),
  ...page.groups.map((group) => ({ kind: "group" as const, group, sortOrder: group.sortOrder })),
].sort((a, b) => a.sortOrder - b.sortOrder || a.kind.localeCompare(b.kind));
const stateDotClasses: Record<PublicState, string> = {
  operational: "bg-[#34d399]",
  degraded: "bg-[#fbbf24]",
  outage: "bg-[#fb7185]",
  unknown: "bg-[#a1a1aa]",
};
const overallBorderClasses: Record<PublicState, string> = {
  operational: "border-[#27664e]",
  degraded: "border-[#9a711d]",
  outage: "border-[#9d4355]",
  unknown: "border-[#3f3f46]",
};
const overallHeadingClasses: Record<PublicState, string> = {
  operational: "bg-[#10221b]",
  degraded: "bg-[#30260f]",
  outage: "bg-[#30191e]",
  unknown: "bg-[#1b1b1f]",
};
const overallIconClasses: Record<PublicState, string> = {
  operational: "text-[#34d399]",
  degraded: "text-[#fbbf24]",
  outage: "text-[#fb7185]",
  unknown: "text-[#a1a1aa]",
};
const groupStateClasses: Record<PublicState, string> = {
  operational: "text-[#6ee7b7]",
  degraded: "text-[#fcd34d]",
  outage: "text-[#fda4af]",
  unknown: "text-[#b4b4bd]",
};
---
<BaseLayout title={showStatusSuffix ? `${page.name} status` : page.name} description={page.description || `Current status and incident history for ${page.name}.`} accent={page.accentColor} canonical={page.canonicalUrl} faviconUrl={page.logoUrl}>
  <Analytics slug={page.slug} />
  <main class="mx-auto w-[min(100%_-_48px,800px)] pt-[38px] pb-[88px] max-[600px]:w-[min(100%_-_32px,800px)] max-[600px]:pt-6 max-[600px]:pb-[62px]">
    <header class="mb-16 flex items-center justify-between gap-5 max-[600px]:mb-[54px] max-[420px]:items-start">
      <div class="flex min-w-0 items-center gap-3">
        {page.logoUrl
          ? <img class="size-10 flex-none rounded-[10px] bg-[#18181b] object-cover" src={page.logoUrl} alt="" width="40" height="40" />
          : <div class="grid size-10 flex-none place-items-center rounded-[10px] bg-[color-mix(in_srgb,var(--accent)_28%,#18181b)] text-xl font-[750]" aria-hidden="true">{page.name.slice(0, 1).toUpperCase()}</div>}
        <h1 class="m-0 text-[17px] font-semibold tracking-[-0.025em] [overflow-wrap:anywhere]">{page.name}{showStatusSuffix && <span class="font-[450] text-[#a1a1aa]"> Status</span>}</h1>
      </div>
      {subscriptionsEnabled && <GetUpdates pageId={page.id} pageName={page.name} subscribed={subscribed} client:load />}
    </header>

    <section class:list={["overflow-hidden rounded-[14px] border bg-[#101012]", overallBorderClasses[currentState]]} aria-labelledby="overall-heading">
      <div class:list={["flex min-h-[74px] items-center gap-[14px] px-6 py-5 max-[600px]:min-h-16 max-[600px]:p-[17px]", overallHeadingClasses[currentState]]}>
        <span class:list={["inline-flex size-6 flex-none [&_svg]:size-full", overallIconClasses[currentState]]} aria-hidden="true">
          {currentState === "operational"
            ? <svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            : currentState === "unknown"
              ? <svg viewBox="0 0 24 24" fill="none"><path d="M12 16v.01M9.1 9a3 3 0 1 1 5.5 1.6c-.8 1-2.6 1.2-2.6 3.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              : <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.4 21.1 19a1 1 0 0 1-.9 1.5H3.8a1 1 0 0 1-.9-1.5L12 3.4Z" fill="currentColor" /><path d="M12 9v5m0 3v.1" stroke="#17120a" stroke-width="2" stroke-linecap="round" /></svg>}
        </span>
        <h2 class="m-0 text-[clamp(19px,3vw,23px)] leading-[1.3] font-medium tracking-[-0.03em]" id="overall-heading">{hasIssues ? "We’re currently experiencing issues" : stateCopy[currentState]}</h2>
      </div>
      {hasIssues ? <>
        {affectedComponents.length > 0 && <ul class:list={["m-0 flex list-none flex-wrap gap-2 border-t px-6 py-[17px] max-[600px]:px-[17px] max-[600px]:py-[14px]", currentState === "outage" ? "border-[#473039]" : "border-[#3d3527]"]} aria-label="Affected components">{affectedComponents.map((name) => <li class:list={["rounded-[7px] border px-[9px] py-[5px] text-xs font-semibold", currentState === "outage" ? "border-[#754050] bg-[#321c23] text-[#fda4af]" : "border-[#6d5222] bg-[#302510] text-[#fcd984]"]}>{name}</li>)}</ul>}
        {activeIncidents.length > 0
          ? <ol class:list={["m-0 list-none border-t p-0", currentState === "outage" ? "border-[#473039]" : "border-[#3d3527]"]}>{activeIncidents.map((incident) => <li class="grid grid-cols-[14px_minmax(0,1fr)] gap-[13px] border-t border-[#303036] px-6 py-[19px] first:border-t-0 max-[600px]:p-[17px]">
              <span class:list={["mt-[5px] block size-[9px] rounded-full", currentState === "outage" ? "bg-[#fb7185]" : "bg-[#fbbf24]"]} aria-hidden="true"></span>
              <div>
                <h3 class="m-0 text-[15px] leading-[1.45] font-[560]"><a class="text-[#f4f4f5] no-underline hover:underline hover:underline-offset-[3px]" href={`${incidentBasePath}/${encodeURIComponent(incident.id)}`}>{incident.title}</a></h3>
                {incident.updates.length > 0
                  ? <div class="text-[13px] leading-[1.55] text-[#d4d4d8] [overflow-wrap:anywhere] [&_a]:text-[#a78bfa] [&_a]:underline [&_blockquote]:mt-2 [&_blockquote]:border-l-2 [&_blockquote]:border-[#71717a] [&_blockquote]:pl-3 [&_blockquote]:text-[#a1a1aa] [&_h2]:mt-2 [&_h2]:text-[13px] [&_h2]:font-semibold [&_h2]:text-[#f4f4f5] [&_h3]:mt-2 [&_h3]:text-[13px] [&_h3]:font-semibold [&_h3]:text-[#f4f4f5] [&_ol]:mt-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-2 [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5" set:html={renderIncidentHtml(incident.updates.at(-1)?.body, incident.latestNote ?? "")} />
                  : incident.latestNote && <p class="mt-2 whitespace-pre-wrap text-[13px] leading-[1.55] text-[#d4d4d8]">{incident.latestNote}</p>}
                <div class="mt-[10px] flex flex-wrap gap-x-2 gap-y-[5px] text-[11px] leading-normal text-[#a1a1aa]"><span>{incidentStage(incident)}</span><span aria-hidden="true">·</span><span>{ongoingFor(incident.startedAt)}</span>{incident.components.length > 0 && <><span aria-hidden="true">·</span><span>Affects {incident.components.join(", ")}</span></>}</div>
              </div>
            </li>)}</ol>
          : <p class="m-0 border-t border-[#3d3527] px-6 py-[18px] text-[13px] leading-[1.55] text-[#a1a1aa] max-[600px]:p-[17px]">Monitoring has detected an issue. No incident report has been published yet.</p>}
      </> : <p class="m-0 px-6 py-5 text-[13px] leading-[1.6] text-[#a1a1aa] max-[600px]:p-[17px]">{page.description || "Current service health and incident updates."}</p>}
    </section>

    <section class="mt-[68px] max-[600px]:mt-14" aria-labelledby="components-heading">
      <div class="mb-4 flex items-baseline justify-between gap-4"><h2 class="m-0 text-[19px] font-medium tracking-[-0.03em]" id="components-heading">System status</h2><span class="whitespace-nowrap text-xs text-[#85858f]">{page.standaloneComponents.length + page.groups.reduce((count, group) => count + group.components.length, 0)} components</span></div>
      {page.groups.length === 0 && page.standaloneComponents.length === 0
        ? <div class="overflow-hidden rounded-[13px] border border-[#303036] bg-[#101012] p-[22px] text-[13px] text-[#a1a1aa]">No components have been published yet.</div>
        : <div class="overflow-hidden rounded-[13px] border border-[#303036] bg-[#101012]">
        {rootItems.map((item) => item.kind === "component" ? <div class="border-t border-[#303036] p-5 first:border-t-0 max-[600px]:p-[15px]">
          <div class="flex items-start justify-between gap-[18px] max-[420px]:items-start">
            <div class="min-w-0"><span class="flex items-center gap-[9px]"><span class="inline-flex flex-none" aria-label={stateLabel[item.component.state]}><span class:list={["inline-block size-[13px] flex-none rounded-full", stateDotClasses[item.component.state]]} aria-hidden="true"></span></span><strong class="text-[13px] font-[580]">{item.component.name}</strong></span>{item.component.description && <p class="mt-[5px] ml-[22px] text-xs leading-[1.45] text-[#a1a1aa]">{item.component.description}</p>}{item.component.manual && <small class="mt-[5px] ml-[22px] block text-[11px] text-[#85858f]">{formatDate(item.component.updatedAt)}</small>}</div>
            <span class:list={["mt-px flex-none whitespace-nowrap text-xs [font-variant-numeric:tabular-nums] max-[420px]:text-[11px]", item.component.observedUptime90d === null ? "text-[#85858f]" : "text-[#6ee7b7]"]}>{item.component.observedUptime90d === null ? "No uptime data" : `${item.component.observedUptime90d.toFixed(3)}% uptime`}</span>
          </div>
          <ComponentHistoryChart name={item.component.name} history={item.component.history} incidentBasePath={incidentBasePath} client:load />
        </div> : (
        <details class="group border-t border-[#303036] first:border-t-0">
          <summary class="block cursor-pointer list-none bg-[#18181b] hover:bg-[#1d1d21] [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-[18px] p-5 max-[600px]:items-start max-[600px]:p-[15px]">
              <span class="flex flex-wrap items-center gap-3"><strong class="text-[13px] font-semibold">{item.group.name}</strong><span class:list={["inline-flex flex-none items-center gap-2 whitespace-nowrap text-xs max-[420px]:text-[11px]", groupStateClasses[item.group.state]]}><span class:list={["inline-block size-[7px] flex-none rounded-full", stateDotClasses[item.group.state]]} aria-hidden="true"></span>{stateLabel[item.group.state]}</span></span>
              <span class="flex items-center gap-[17px] max-[600px]:gap-[9px]"><span class="flex-none text-xs text-[#a1a1aa] max-[600px]:text-[11px]">{item.group.components.length} {item.group.components.length === 1 ? "component" : "components"}</span><svg class="block flex-none text-[#a1a1aa] transition-transform duration-150 ease-in group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="m6 8 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            </span>
          </summary>
          <div class="border-t border-[#303036]">
            {item.group.components.length === 0 ? <p class="m-0 p-[22px] text-[13px] text-[#a1a1aa]">No visible components in this group.</p> : item.group.components.map((component) => (
              <div class="border-t border-[#28282d] p-5 first:border-t-0 max-[600px]:p-[15px]">
                <div class="flex items-start justify-between gap-[18px] max-[420px]:items-start">
                  <div class="min-w-0"><span class="flex items-center gap-[9px]"><span class="inline-flex flex-none" aria-label={stateLabel[component.state]}><span class:list={["inline-block size-[13px] flex-none rounded-full", stateDotClasses[component.state]]} aria-hidden="true"></span></span><strong class="text-[13px] font-[580]">{component.name}</strong></span>{component.description && <p class="mt-[5px] ml-[22px] text-xs leading-[1.45] text-[#a1a1aa]">{component.description}</p>}{component.manual && <small class="mt-[5px] ml-[22px] block text-[11px] text-[#85858f]">{formatDate(component.updatedAt)}</small>}</div>
                  <span class:list={["mt-px flex-none whitespace-nowrap text-xs [font-variant-numeric:tabular-nums] max-[420px]:text-[11px]", component.observedUptime90d === null ? "text-[#85858f]" : "text-[#6ee7b7]"]}>{component.observedUptime90d === null ? "No uptime data" : `${component.observedUptime90d.toFixed(3)}% uptime`}</span>
                </div>
                <ComponentHistoryChart name={component.name} history={component.history} incidentBasePath={incidentBasePath} client:load />
              </div>
            ))}
          </div>
        </details>
      ))}</div>}
      {(page.groups.length > 0 || page.standaloneComponents.length > 0) && <p class="mt-[10px] text-[11px] leading-normal text-[#85858f]">Component history covers the last 90 days. Gray days have no complete monitoring evidence; published manual incidents appear on affected components.</p>}
    </section>

    <section class="mt-[68px] max-[600px]:mt-14" aria-labelledby="incidents-heading">
      <div class="mb-4 flex items-baseline justify-between gap-4"><h2 class="m-0 text-[19px] font-semibold tracking-[-0.03em]" id="incidents-heading">Incident history</h2><span class="whitespace-nowrap text-xs text-[#85858f]">{pastIncidents.length} resolved</span></div>
      {pastIncidents.length === 0
        ? <div class="overflow-hidden rounded-[13px] border border-[#303036] bg-[#101012] p-[22px] text-[13px] text-[#a1a1aa]">No past incidents to show.</div>
        : <ol class="m-0 list-none overflow-hidden rounded-[13px] border border-[#303036] bg-[#101012] p-0">{pastIncidents.map((incident) => (
        <li class="grid grid-cols-[8px_minmax(0,1fr)] gap-[15px] border-t border-[#303036] px-5 py-[18px] first:border-t-0">
          <span class:list={["mt-[5px] size-2 rounded-full", incident.status === "resolved" ? "bg-[#34d399]" : "bg-[#fb7185]"]} aria-hidden="true"></span>
          <div><div class="flex flex-wrap items-baseline justify-between gap-x-[14px] gap-y-2"><strong class="text-[13px] font-[580]"><a class="no-underline hover:underline hover:underline-offset-[3px]" href={`${incidentBasePath}/${encodeURIComponent(incident.id)}`}>{incident.title}</a></strong><span class:list={["text-[11px]", incident.status === "resolved" ? "text-[#6ee7b7]" : "text-[#fda4af]"]}>{incident.status === "resolved" ? "Resolved" : "Investigating"}</span></div>
            {incident.components.length > 0 && <p class="mt-[7px] text-xs leading-[1.55] text-[#a1a1aa]">Affects {incident.components.join(", ")}</p>}
            {incident.latestNote && <p class="mt-[7px] whitespace-pre-wrap text-xs leading-[1.55] text-[#d4d4d8]">{incident.latestNote}</p>}
            <time class="mt-2 block text-[11px] text-[#85858f]" datetime={incident.startedAt.toISOString()}>{formatDate(incident.startedAt)}</time>
            {incident.updates.length > 0 && <details class="mt-3"><summary class="w-max cursor-pointer text-xs text-[#c4b5fd]">View {incident.updates.length} published {incident.updates.length === 1 ? "update" : "updates"}</summary><ol class="mt-3 list-none border-l border-[#36303f] pl-4">{incident.updates.map((update) => <li class="mt-4 first:mt-0"><div class="flex flex-wrap items-baseline gap-3"><strong class="text-xs font-semibold text-[#d4d4d8] capitalize">{update.status}</strong><time class="m-0 inline text-[11px] text-[#85858f]" datetime={update.publishedAt.toISOString()}>{formatDate(update.publishedAt)}</time></div><div class="text-[13px] leading-[1.55] text-[#d4d4d8] [overflow-wrap:anywhere] [&_a]:text-[#a78bfa] [&_a]:underline [&_blockquote]:mt-2 [&_blockquote]:border-l-2 [&_blockquote]:border-[#71717a] [&_blockquote]:pl-3 [&_blockquote]:text-[#a1a1aa] [&_h2]:mt-2 [&_h2]:text-[13px] [&_h2]:font-semibold [&_h2]:text-[#f4f4f5] [&_h3]:mt-2 [&_h3]:text-[13px] [&_h3]:font-semibold [&_h3]:text-[#f4f4f5] [&_ol]:mt-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-[6px] [&_p]:whitespace-pre-wrap [&_p]:text-xs [&_p]:leading-normal [&_p]:text-[#a1a1aa] [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:pl-5" set:html={renderIncidentHtml(update.body, update.note)} /></li>)}</ol></details>}
          </div>
        </li>
      ))}</ol>}
    </section>

  </main>
</BaseLayout>
