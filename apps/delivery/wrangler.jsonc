{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "outray-delivery",
  "main": "src/index.ts",
  "account_id": "c24bce6c7c75dad3f96b41f09a1f00d5",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "delivery.outray.co", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "destinations": ["outray-ops-worker-logs"],
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "destinations": ["outray-ops-worker-traces"],
    },
  },
  "vars": { "PUBLIC_DELIVERY_URL": "https://delivery.outray.co" },
  "r2_buckets": [
    { "binding": "STATUS_PAGE_LOGOS", "bucket_name": "outray" }
  ]
}
