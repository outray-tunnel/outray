---
const { title = "OutRay Share", description = "Share sensitive information with an encrypted, expiring link.", showHeader = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/outray-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page-shell">
      {showHeader && <header class="site-header">
        <a class="brand" href="/" aria-label="OutRay Share home">
          <img src="/outray-mark.svg" width="27" height="27" alt="" />
          <span>OutRay<span class="brand-muted"> / Share</span></span>
        </a>
      </header>}
      <main><slot /></main>
    </div>
  </body>
</html>
<style is:global>
  @font-face { font-family: Geom; src: url('/fonts/geom-latin.woff2') format('woff2'); font-display: swap; }
  :root { color-scheme: dark; font-family: Geom, Inter, system-ui, sans-serif; background: #080809; color: #f5f5f6; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  button, input, textarea, select { font: inherit; }
  button { cursor: pointer; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid #a991e7; outline-offset: 3px; }
  .page-shell { min-height: 100vh; max-width: 1280px; margin: 0 auto; padding: 0 36px; display: flex; flex-direction: column; }
  .site-header { height: 86px; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; font-size: 18px; font-weight: 600; letter-spacing: -.04em; }
  .brand img { filter: brightness(0) invert(1); }
  .brand-muted { color: #85858c; }
  .brand-muted { font-weight: 400; }
  main { width: 100%; flex: 1; }
  .share-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(48px, 7vw, 116px); align-items: center; align-content: center; justify-items: center; min-height: 100vh; padding: 48px 0; }
  .share-layout > astro-island { min-width: 0; width: 100%; }
  .hero { width: 100%; max-width: 490px; text-align: left; }
  h1 { font-size: clamp(42px, 4.8vw, 62px); line-height: 1.06; letter-spacing: -.052em; font-weight: 500; margin: 19px 0 22px; }
  .hero h1 { margin-top: 22px; }
  .hero-copy { font-size: 15px; line-height: 1.7; color: #aaaab1; max-width: 470px; margin: 0; }
  .hero-footnote { display: flex; align-items: center; gap: 10px; color: #83838c; font-size: 12px; margin: 34px 0 0; }
  .hero-footnote span { width: 6px; height: 6px; border-radius: 50%; background: #38c999; box-shadow: 0 0 0 4px #38c99915; flex: none; }
  .share-card { width: 100%; max-width: 760px; border: 1px solid #2d2d32; border-radius: 20px; background: #101013; overflow: hidden; }
  .composer-card { overflow: visible; }
  .reveal-card { overflow: visible; }
  .card-top { padding: 24px 28px; border-bottom: 1px solid #26262b; }
  .card-top h2 { font-size: 18px; font-weight: 500; letter-spacing: -.025em; margin: 0 0 5px; }
  .card-top p { font-size: 13px; color: #8d8d95; margin: 0; line-height: 1.5; }
  .reveal-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .reveal-card-top > div:first-child { min-width: 0; }
  .export-control { position: relative; flex: none; z-index: 10; }
  .export-trigger { display: inline-flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 92px; min-height: 34px; padding: 0 10px 0 12px; border: 1px solid #38383e; border-radius: 8px; color: #e7e7ea; background: #1a1a1e; font-size: 12px; }
  .export-trigger:hover, .export-trigger[aria-expanded="true"] { background: #242429; border-color: #4a4a51; }
  .export-trigger[aria-expanded="true"] { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .export-trigger svg { width: 15px; height: 15px; color: #a2a2aa; transition: transform .16s ease; }
  .export-trigger[aria-expanded="true"] svg { transform: rotate(180deg); }
  .export-dropdown { position: absolute; top: calc(100% - 1px); right: 0; width: 212px; padding: 5px; border: 1px solid #4a4a51; border-radius: 9px 0 9px 9px; background: #1b1b20; box-shadow: 0 16px 34px #0009; }
  .export-dropdown button { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 8px 10px; border: 0; border-radius: 6px; color: #eeeef1; background: transparent; text-align: left; font-size: 12px; }
  .export-dropdown button:hover, .export-dropdown button:focus-visible { background: #303036; }
  .export-dropdown button small { color: #92929c; font-size: 11px; }
  .export-dropdown p { margin: 5px 5px 3px; padding: 9px 5px 2px; border-top: 1px solid #34343b; color: #898992; font-size: 11px; }
  .card-body { padding: 27px 28px 30px; }
  .composer-card .card-body { padding: 26px; }
  .form-heading { margin-bottom: 22px; }
  .form-title { display: flex; align-items: center; gap: 9px; margin-bottom: 6px; }
  .form-title svg { width: 19px; height: 19px; flex: none; color: #c2acd9; }
  .form-heading h2 { font-size: 19px; line-height: 1.25; letter-spacing: -.025em; font-weight: 500; margin: 0; }
  .form-heading p { font-size: 13px; line-height: 1.5; color: #8d8d95; margin: 0; }
  .form-field { margin-bottom: 22px; }
  .format-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .format-row .field-label { margin-bottom: 0; }
  .mode-switch { display: inline-flex; gap: 3px; padding: 4px; border: 1px solid #303036; background: #18181d; border-radius: 11px; }
  .mode-switch button { background: transparent; border: 0; border-radius: 8px; padding: 8px 15px; font-size: 13px; color: #8e8e96; }
  .mode-switch button[aria-pressed="true"] { background: #313038; color: #fff; }
  .field-label { display: block; font-size: 13px; color: #d7d7dd; margin-bottom: 9px; }
  .field-note { color: #85858f; font-size: 12px; margin-top: 8px; line-height: 1.55; }
  .control { width: 100%; color: #f0f0f3; background: #0c0c0f; border: 1px solid #303036; border-radius: 11px; min-height: 43px; padding: 10px 13px; outline: none; }
  .control:focus { border-color: #9b82d9; box-shadow: 0 0 0 2px #8367c72b; }
  textarea.control { resize: vertical; min-height: 118px; line-height: 1.6; }
  .control::placeholder { color: #62626b; }
  .entries { display: grid; gap: 10px; }
  .env-paste-hint { color: #85858f; font-size: 12px; line-height: 1.5; margin: -3px 0 12px; }
  .env-paste-hint code { color: #bfb0df; font: 11px ui-monospace, monospace; }
  .paste-error { color: #ffc5ce; font-size: 12px; line-height: 1.5; margin: 10px 0 0; }
  .entry-row { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(170px, 1.5fr) auto; gap: 9px; }
  .entry-row .entry-value { min-height: 43px; line-height: 1.5; resize: vertical; }
  .entry-row button { background: #1d1d21; border: 1px solid #333339; border-radius: 10px; color: #b3b3bb; min-width: 42px; }
  .secondary-button { border: 1px solid #3a3a42; background: #1b1b20; color: #dddde2; border-radius: 10px; min-height: 40px; padding: 0 14px; font-size: 13px; }
  .secondary-button:hover { background: #28272d; }
  .select-wrap { position: relative; }
  .expiry-trigger { display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left; cursor: pointer; }
  .expiry-trigger[aria-expanded="true"] { border-color: #9b82d9; box-shadow: 0 0 0 2px #8367c72b; }
  .select-wrap svg { width: 18px; height: 18px; flex: none; color: #aaaab2; pointer-events: none; }
  .expiry-menu { position: absolute; z-index: 20; top: calc(100% + 6px); left: 0; right: 0; max-height: 280px; overflow-y: auto; padding: 5px; border: 1px solid #383840; border-radius: 11px; background: #1b1b20; box-shadow: 0 18px 45px #0009; }
  .expiry-option { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; min-height: 36px; padding: 7px 10px; border: 0; border-radius: 7px; background: transparent; color: #c5c5cc; font-size: 13px; text-align: left; }
  .expiry-option:hover, .expiry-option:focus-visible { background: #2b2535; color: #fff; }
  .expiry-option[aria-selected="true"] { color: #d9c7ff; }
  .expiry-option svg { color: #ad91e9; }
  .expiry-field { margin-bottom: 22px; }
  .expiry-hint { color: #898991; font-size: 12px; line-height: 1.5; margin: 8px 0 0; }
  .advanced-options { border: 1px solid #303036; border-radius: 11px; background: #151518; overflow: hidden; }
  .advanced-options summary { display: flex; align-items: center; gap: 10px; list-style: none; min-height: 49px; padding: 0 14px; cursor: pointer; color: #dedee3; font-size: 13px; }
  .advanced-options summary:hover { background: #1c1c20; }
  .advanced-options summary::-webkit-details-marker { display: none; }
  .advanced-options summary svg { width: 17px; height: 17px; flex: none; color: #8d8d95; }
  .advanced-options summary .options-chevron { transition: transform .18s; }
  .advanced-options[open] summary .options-chevron { transform: rotate(180deg); }
  .summary-hint { color: #797983; font-size: 12px; margin-left: auto; }
  .advanced-body { padding: 18px 14px 2px; border-top: 1px solid #303036; }
  .advanced-body .form-field:last-child { margin-bottom: 16px; }
  .optional-label { color: #85858f; font-weight: 400; margin-left: 5px; }
  .password-control { position: relative; }
  .password-control .control { padding-right: 65px; }
  .password-control button { position: absolute; right: 0; top: 0; height: 44px; padding: 0 11px; border: 0; border-radius: 7px; background: transparent; color: #aaaab2; font-size: 12px; }
  .password-control button:hover { background: #25252b; color: white; }
  .primary-button { border: 1px solid #f0eff4; border-radius: 11px; min-height: 43px; padding: 0 19px; color: #101013; background: #f0eff4; font-size: 13px; font-weight: 600; }
  .primary-button:hover { background: #d8d5e0; }
  .action-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 22px; }
  .action-row .primary-button { flex: none; }
  .powered-by { display: inline-flex; align-items: center; gap: 7px; color: #898991; font-size: 12px; text-decoration: none; white-space: nowrap; }
  .powered-by:hover { color: #e4e4e8; }
  .powered-by img { filter: brightness(0) invert(1); opacity: .6; }
  .powered-by:hover img { opacity: 1; }
  .alert { border-radius: 10px; border: 1px solid #a24152; background: #3a151d; color: #ffc5ce; padding: 10px 13px; font-size: 13px; margin: 16px 0 0; }
  .success-box { border: 1px solid #3f6355; background: #10231b; border-radius: 13px; padding: 18px; }
  .success-box h3 { font-weight: 500; font-size: 17px; margin: 0 0 8px; }
  .success-box p { font-size: 13px; color: #b7cabd; line-height: 1.55; }
  .link-row { display: flex; gap: 8px; margin-top: 15px; }
  .link-row .control { font-family: ui-monospace, monospace; font-size: 12px; }
  .reveal-wrap { display: flex; flex-direction: column; justify-content: center; width: 100%; max-width: 720px; min-height: calc(100vh - 86px); margin: 0 auto; padding: 56px 0; }
  .reveal-wrap h1 { font-size: clamp(38px, 5vw, 57px); }
  .reveal-wrap .share-card { margin: 36px 0 0; }
  .reveal-wrap .form-field { max-width: 420px; }
  .share-your-own { align-self: center; display: inline-flex; align-items: center; gap: 7px; margin-top: 26px; color: #aaaab2; font-size: 13px; text-decoration: none; }
  .share-your-own:hover { color: #f5f5f6; }
  .share-your-own span { font-size: 17px; line-height: 1; }
  .revealed-text { white-space: pre-wrap; overflow-wrap: anywhere; font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.65; background: #0b0b0e; border: 1px solid #303036; padding: 17px; border-radius: 11px; }
  .export-error { margin: 0 0 15px; }
  .secret-list { border: 1px solid #303036; border-radius: 11px; overflow: hidden; }
  .secret-list-heading, .secret-row { display: grid; grid-template-columns: minmax(110px, .85fr) minmax(0, 1.65fr) 55px; column-gap: 16px; }
  .secret-list-heading { padding: 10px 16px; border-bottom: 1px solid #303036; color: #85858f; background: #18181b; font-size: 11px; }
  .secret-row { align-items: start; padding: 13px 16px; background: #0c0c0f; }
  .secret-row + .secret-row { border-top: 1px solid #29292e; }
  .secret-key, .secret-value { min-width: 0; overflow-wrap: anywhere; font: 12px/1.65 ui-monospace, monospace; white-space: pre-wrap; }
  .secret-key { color: #bda7e3; }
  .secret-value { color: #e7e7ea; }
  .secret-copy { justify-self: end; min-height: 22px; padding: 1px 0; border: 0; background: transparent; color: #95959e; font-size: 11px; }
  .secret-copy:hover { color: #f5f5f6; }
  @media (max-width: 900px) { .share-layout { grid-template-columns: 1fr; gap: 34px; padding: 64px 0; } .hero { max-width: 660px; } .share-card { max-width: 660px; } .hero-footnote { margin-top: 20px; } }
  @media (max-width: 640px) { .page-shell { padding: 0 18px; } .site-header { height: 70px; } .share-layout { gap: 28px; padding: 40px 0 64px; } .card-top, .card-body, .composer-card .card-body { padding-left: 18px; padding-right: 18px; } .format-row { align-items: flex-start; flex-direction: column; gap: 9px; } .entry-row { grid-template-columns: 1fr auto; } .entry-row .entry-value { grid-column: 1; grid-row: 2; } .entry-row button { grid-column: 2; grid-row: 1 / 3; } .summary-hint { display: none; } .advanced-options summary .options-chevron { margin-left: auto; } .action-row { align-items: stretch; flex-direction: column-reverse; gap: 14px; } .action-row .primary-button { width: 100%; } .powered-by { align-self: center; } .link-row { flex-direction: column; } .reveal-wrap { min-height: calc(100vh - 70px); padding: 40px 0 64px; } }
  @media (max-width: 640px) { .reveal-card-top { align-items: flex-start; } .reveal-card-top p { max-width: 230px; } .secret-list-heading { display: none; } .secret-row { grid-template-columns: minmax(0, 1fr) auto; gap: 5px 12px; } .secret-key { grid-column: 1; grid-row: 1; } .secret-copy { grid-column: 2; grid-row: 1; } .secret-value { grid-column: 1 / -1; grid-row: 2; } }
  @media (prefers-reduced-motion: reduce) { .advanced-options summary .options-chevron, .export-trigger svg { transition: none; } }
</style>
