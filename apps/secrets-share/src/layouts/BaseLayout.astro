---
const { title = "OutRay Share", description = "Share sensitive information with an encrypted, expiring link." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/outray-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="OutRay Share home">
          <img src="/outray-mark.svg" width="27" height="27" alt="" />
          <span>OutRay<span class="brand-muted"> / Share</span></span>
        </a>
        <span class="header-note">Private by design</span>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>OutRay Share</span>
        <span>Encrypted in your browser · No account required</span>
      </footer>
    </div>
  </body>
</html>
<style is:global>
  @font-face { font-family: Geom; src: url('/fonts/geom-latin.woff2') format('woff2'); font-display: swap; }
  :root { color-scheme: dark; font-family: Geom, Inter, system-ui, sans-serif; background: #080809; color: #f5f5f6; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  button, input, textarea, select { font: inherit; }
  button { cursor: pointer; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid #a991e7; outline-offset: 3px; }
  .page-shell { min-height: 100vh; max-width: 1220px; margin: 0 auto; padding: 0 32px; display: flex; flex-direction: column; }
  .site-header { height: 86px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #242428; }
  .brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; font-size: 18px; font-weight: 600; letter-spacing: -.04em; }
  .brand img { filter: brightness(0) invert(1); }
  .brand-muted, .header-note, .site-footer { color: #85858c; }
  .brand-muted { font-weight: 400; }
  .header-note { font-size: 12px; }
  main { width: 100%; flex: 1; }
  .site-footer { border-top: 1px solid #242428; min-height: 75px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 12px; }
  .hero { padding: 92px 0 46px; max-width: 730px; }
  .eyebrow { color: #a991e7; font-size: 12px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  h1 { font-size: clamp(42px, 6vw, 70px); line-height: 1.04; letter-spacing: -.055em; font-weight: 500; margin: 18px 0 20px; }
  .hero-copy { font-size: 16px; line-height: 1.65; color: #aaaab1; max-width: 580px; margin: 0; }
  .share-card { max-width: 760px; border: 1px solid #2d2d32; border-radius: 23px; background: #101013; margin-bottom: 94px; overflow: hidden; }
  .card-top { padding: 24px 28px; border-bottom: 1px solid #26262b; }
  .card-top h2 { font-size: 18px; font-weight: 500; letter-spacing: -.025em; margin: 0 0 5px; }
  .card-top p { font-size: 13px; color: #8d8d95; margin: 0; line-height: 1.5; }
  .card-body { padding: 27px 28px 30px; }
  .mode-switch { display: inline-flex; gap: 3px; padding: 4px; border: 1px solid #303036; background: #18181d; border-radius: 11px; margin-bottom: 22px; }
  .mode-switch button { background: transparent; border: 0; border-radius: 8px; padding: 8px 15px; font-size: 13px; color: #8e8e96; }
  .mode-switch button[aria-pressed="true"] { background: #313038; color: #fff; }
  .field-label { display: block; font-size: 13px; color: #d7d7dd; margin-bottom: 9px; }
  .field-note { color: #85858f; font-size: 12px; margin-top: 8px; line-height: 1.55; }
  .control { width: 100%; color: #f0f0f3; background: #0c0c0f; border: 1px solid #303036; border-radius: 11px; min-height: 43px; padding: 10px 13px; outline: none; }
  .control:focus { border-color: #9b82d9; box-shadow: 0 0 0 2px #8367c72b; }
  textarea.control { resize: vertical; min-height: 156px; line-height: 1.6; }
  .control::placeholder { color: #62626b; }
  .entries { display: grid; gap: 10px; }
  .entry-row { display: grid; grid-template-columns: minmax(130px, 1fr) minmax(170px, 1.5fr) auto; gap: 9px; }
  .entry-row button { background: #1d1d21; border: 1px solid #333339; border-radius: 10px; color: #b3b3bb; min-width: 42px; }
  .secondary-button { border: 1px solid #3a3a42; background: #1b1b20; color: #dddde2; border-radius: 10px; min-height: 40px; padding: 0 14px; font-size: 13px; }
  .secondary-button:hover { background: #28272d; }
  .limits { margin-top: 26px; padding-top: 24px; border-top: 1px solid #2b2b30; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .duration-controls { display: grid; grid-template-columns: minmax(80px, 1fr) minmax(110px, 1fr); gap: 8px; }
  .primary-button { border: 1px solid #f0eff4; border-radius: 11px; min-height: 43px; padding: 0 19px; color: #101013; background: #f0eff4; font-size: 13px; font-weight: 600; }
  .primary-button:hover { background: #d8d5e0; }
  .action-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 27px; }
  .action-row p { color: #8d8d95; font-size: 12px; line-height: 1.5; margin: 0; max-width: 370px; }
  .alert { border-radius: 10px; border: 1px solid #a24152; background: #3a151d; color: #ffc5ce; padding: 10px 13px; font-size: 13px; margin: 16px 0 0; }
  .success-box { border: 1px solid #3f6355; background: #10231b; border-radius: 13px; padding: 18px; }
  .success-box h3 { font-weight: 500; font-size: 17px; margin: 0 0 8px; }
  .success-box p { font-size: 13px; color: #b7cabd; line-height: 1.55; }
  .link-row { display: flex; gap: 8px; margin-top: 15px; }
  .link-row .control { font-family: ui-monospace, monospace; font-size: 12px; }
  .reveal-wrap { max-width: 720px; padding: 105px 0 95px; }
  .reveal-wrap h1 { font-size: clamp(38px, 5vw, 57px); }
  .reveal-wrap .share-card { margin: 36px 0 0; }
  .revealed-text { white-space: pre-wrap; overflow-wrap: anywhere; font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.65; background: #0b0b0e; border: 1px solid #303036; padding: 17px; border-radius: 11px; }
  .revealed-entry { border-bottom: 1px solid #29292e; padding: 13px 0; }
  .revealed-entry:last-child { border-bottom: 0; }
  .revealed-entry strong { display: block; font: 12px ui-monospace, monospace; color: #a991e7; margin-bottom: 8px; }
  @media (max-width: 640px) { .page-shell { padding: 0 18px; } .site-header { height: 70px; } .header-note { display: none; } .site-footer { align-items: flex-start; flex-direction: column; justify-content: center; padding: 18px 0; } .hero { padding: 65px 0 34px; } .card-top, .card-body { padding-left: 18px; padding-right: 18px; } .entry-row { grid-template-columns: 1fr auto; } .entry-row input:nth-child(2) { grid-column: 1; grid-row: 2; } .entry-row button { grid-column: 2; grid-row: 1 / 3; } .limits { grid-template-columns: 1fr; } .action-row { flex-direction: column; align-items: stretch; } .link-row { flex-direction: column; } .reveal-wrap { padding: 65px 0; } }
</style>
