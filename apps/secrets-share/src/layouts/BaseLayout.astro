---
import "../styles/global.css";

const { title = "OutRay Share", description = "Share sensitive information with an encrypted, expiring link.", showHeader = true } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-[#080809] font-sans text-[#f5f5f6] [color-scheme:dark]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/outray-mark.svg" type="image/svg+xml" />
  </head>
  <body class="m-0 min-w-80 [&_button]:cursor-pointer [&_button:disabled]:cursor-not-allowed [&_button:disabled]:opacity-55 [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-[3px] [&_:focus-visible]:outline-[#a991e7]">
    <div class="mx-auto flex min-h-screen max-w-[1280px] flex-col px-9 max-[640px]:px-[18px]">
      {showHeader && <header class="flex h-[86px] items-center justify-between max-[640px]:h-[70px]">
        <a class="inline-flex items-center gap-[11px] text-lg font-semibold tracking-[-0.04em] no-underline" href="/" aria-label="OutRay Share home">
          <img class="brightness-0 invert" src="/outray-mark.svg" width="27" height="27" alt="" />
          <span>OutRay<span class="font-normal text-[#85858c]"> / Share</span></span>
        </a>
      </header>}
      <main class="w-full flex-1"><slot /></main>
    </div>
  </body>
</html>
