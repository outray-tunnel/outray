---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareComposer from "../components/ShareComposer";
---
<BaseLayout title="Share a secret — OutRay" showHeader={false}>
  <section class="share-layout">
    <div class="hero">
      <a class="brand hero-brand" href="/" aria-label="OutRay Share home">
        <img src="/outray-mark.svg" width="27" height="27" alt="" />
        <span>OutRay<span class="brand-muted"> / Share</span></span>
      </a>
      <h1>Secret sharing.<br />100% free.</h1>
      <p class="hero-copy">Create a temporary link for something sensitive. Only someone with the complete link can open what you share.</p>
      <p class="hero-footnote"><span aria-hidden="true"></span> Encrypted in your browser. No account needed.</p>
    </div>
    <ShareComposer client:load />
  </section>
</BaseLayout>
