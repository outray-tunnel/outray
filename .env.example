# Local service ports
WEB_PORT=6767
TUNNEL_PORT=3547
INTERNAL_CHECK_PORT=3001
INGEST_PORT=4318

# Public and service URLs
APP_URL=http://localhost:6767
BETTER_AUTH_URL=http://localhost:6767
WEB_API_URL=http://localhost:6767/api
VITE_TUNNEL_URL=ws://localhost:3547
BASE_DOMAIN=localhost.direct

# PostgreSQL, TimescaleDB, and Redis
DATABASE_URL=postgresql://user:password@localhost:5432/outray
TIMESCALE_URL=postgresql://user:password@localhost:5432/outray
REDIS_URL=redis://localhost:6379

# Tunnel service tuning
REDIS_TUNNEL_TTL_SECONDS=120
REDIS_HEARTBEAT_INTERVAL_MS=20000
REQUEST_TIMEOUT_MS=60000

# Observability ingestion and Tinybird
TINYBIRD_API_HOST=https://api.europe-west2.gcp.tinybird.co
TINYBIRD_INGEST_TOKEN=your_scoped_tinybird_append_token
TINYBIRD_QUERY_TOKEN=your_scoped_tinybird_read_token
OTLP_MAX_PAYLOAD_BYTES=8388608
OTLP_MAX_RECORDS_PER_REQUEST=10000
OTLP_RATE_LIMIT_PER_MINUTE=600
TCP_PORT_RANGE_MIN=20000
TCP_PORT_RANGE_MAX=30000
UDP_PORT_RANGE_MIN=30001
UDP_PORT_RANGE_MAX=40000

# Shared service authentication
INTERNAL_API_SECRET=generate_a_secure_random_string_here

# Better Auth providers
BETTER_AUTH_SECRET=generate_a_secure_random_string_here
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email providers
ZEPTO_API_KEY=your_zepto_api_key
PLUNK_API_KEY=your_plunk_api_key

# Outray development integration
OUTRAY_API_KEY=your_outray_api_key
OUTRAY_SERVER_URL=ws://localhost:3547
OUTRAY_WEB_URL=http://localhost:6767
OUTRAY_SUBDOMAIN=
OUTRAY_ENABLED=true
TUNNEL_DOMAIN=

# Administration and analytics
ADMIN_PASSPHRASE=choose_a_secure_admin_passphrase
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Polar
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=your_webhook_secret_here
POLAR_SERVER=sandbox
POLAR_PRODUCT_RAY=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_BEAM=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_PULSE=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_RAY_YEARLY=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_BEAM_YEARLY=prod_xxxxxxxxxxxxxxxx
POLAR_PRODUCT_PULSE_YEARLY=prod_xxxxxxxxxxxxxxxx

# Polar IDs exposed to the browser
VITE_POLAR_PRODUCT_RAY=prod_xxxxxxxxxxxxxxxx
VITE_POLAR_PRODUCT_BEAM=prod_xxxxxxxxxxxxxxxx
VITE_POLAR_PRODUCT_PULSE=prod_xxxxxxxxxxxxxxxx
VITE_POLAR_PRODUCT_RAY_YEARLY=prod_xxxxxxxxxxxxxxxx
VITE_POLAR_PRODUCT_BEAM_YEARLY=prod_xxxxxxxxxxxxxxxx
VITE_POLAR_PRODUCT_PULSE_YEARLY=prod_xxxxxxxxxxxxxxxx

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Optional deployment integration
CLOUDFLARE_API_KEY=

# Hugeicons Pro private registry
HUGEICONS_LICENSE_KEY=your_hugeicons_universal_license_key
