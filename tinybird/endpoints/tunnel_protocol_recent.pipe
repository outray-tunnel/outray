TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Recent TCP/UDP events for authorized tunnel identifiers.

NODE events
SQL >
    %
    SELECT timestamp, event_id, tunnel_id, organization_id, protocol,
           event_type, connection_id, client_ip, client_port,
           bytes_in, bytes_out, duration_ms
    FROM tunnel_protocol_events FINAL
    WHERE organization_id = {{String(organization_id)}}
      AND timestamp >= toDateTime64({{DateTime64(start)}}, 3, 'UTC')
      AND timestamp < toDateTime64({{DateTime64(end)}}, 3, 'UTC')
      AND timestamp >= now64(3, 'UTC') - toIntervalDay(least(greatest(retention_days, 1), 90))
      AND has(JSONExtract({{String(tunnel_ids)}}, 'Array(String)'), tunnel_id)
    ORDER BY timestamp DESC, event_id DESC
    LIMIT least(greatest({{UInt32(limit, 50)}}, 1), 501)

TYPE endpoint
