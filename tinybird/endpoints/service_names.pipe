TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Lists all discovered services for one OutRay organization, independently of telemetry time ranges.

NODE services
SQL >
    %
    SELECT
        ServiceName AS service,
        LastSeen AS last_seen
    FROM observability_service_inventory FINAL
    WHERE OrganizationId = {{String(organization_id)}}
    ORDER BY service ASC
    {% if defined(limit) %}
    LIMIT {{Int32(limit)}}
    {% end %}

TYPE endpoint
