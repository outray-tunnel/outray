TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Full safe HTTP request metadata and OutRay capture fields for one server span.

NODE http_spans
SQL >
    %
    SELECT
        concat(TraceId, ':', SpanId) AS id,
        Timestamp AS timestamp,
        EndTimestamp AS end_timestamp,
        TraceId AS trace_id,
        SpanId AS span_id,
        ParentSpanId AS parent_span_id,
        TraceState AS trace_state,
        SpanName AS span_name,
        coalesce(
            nullIf(SpanAttributes['outray.http.request.id'], ''),
            nullIf(SpanAttributes['http.request.id'], ''),
            nullIf(SpanAttributes['request.id'], ''),
            nullIf(SpanAttributes['http.request.header.x-request-id'], ''),
            ''
        ) AS request_id,
        upper(coalesce(
            nullIf(nullIf(upper(HttpMethod), 'EVENT'), ''),
            nullIf(upper(SpanAttributes['http.request.method']), ''),
            nullIf(upper(SpanAttributes['http.method']), ''),
            ''
        )) AS method,
        coalesce(
            nullIf(SpanAttributes['http.route'], ''),
            nullIf(SpanAttributes['url.template'], ''),
            nullIf(SpanAttributes['url.path'], ''),
            nullIf(SpanAttributes['http.target'], ''),
            SpanName
        ) AS route,
        if(
            notEmpty(SpanAttributes['url.path']),
            concat(
                SpanAttributes['url.path'],
                if(
                    empty(SpanAttributes['url.query']),
                    '',
                    concat('?', SpanAttributes['url.query'])
                )
            ),
            coalesce(
                nullIf(SpanAttributes['http.target'], ''),
                nullIf(SpanAttributes['http.route'], ''),
                SpanName
            )
        ) AS path,
        coalesce(
            nullIf(SpanAttributes['url.full'], ''),
            nullIf(SpanAttributes['http.url'], ''),
            ''
        ) AS raw_url,
        coalesce(
            nullIf(SpanAttributes['url.scheme'], ''),
            nullIf(SpanAttributes['http.scheme'], ''),
            ''
        ) AS scheme,
        coalesce(
            nullIf(SpanAttributes['server.address'], ''),
            nullIf(SpanAttributes['net.host.name'], ''),
            nullIf(SpanAttributes['http.host'], ''),
            ''
        ) AS server_address,
        toUInt16OrZero(coalesce(
            nullIf(SpanAttributes['server.port'], ''),
            nullIf(SpanAttributes['net.host.port'], ''),
            '0'
        )) AS server_port,
        if(
            countSubstrings(server_address, ':') > 1
                AND not startsWith(server_address, '['),
            concat('[', server_address, ']'),
            server_address
        ) AS url_server_address,
        if(
            notEmpty(raw_url),
            raw_url,
            if(
                notEmpty(scheme)
                    AND notEmpty(server_address)
                    AND startsWith(path, '/'),
                concat(
                    scheme,
                    '://',
                    url_server_address,
                    if(
                        server_port = 0 OR countSubstrings(server_address, ':') = 1,
                        '',
                        concat(':', toString(server_port))
                    ),
                    path
                ),
                path
            )
        ) AS url,
        coalesce(
            nullIf(SpanAttributes['network.protocol.version'], ''),
            nullIf(SpanAttributes['http.flavor'], ''),
            ''
        ) AS protocol_version,
        if(
            empty(protocol_version),
            coalesce(nullIf(SpanAttributes['network.protocol.name'], ''), ''),
            if(
                startsWith(upper(protocol_version), 'HTTP/'),
                protocol_version,
                concat('HTTP/', protocol_version)
            )
        ) AS protocol,
        coalesce(
            nullIf(SpanAttributes['client.address'], ''),
            nullIf(SpanAttributes['network.peer.address'], ''),
            nullIf(SpanAttributes['net.sock.peer.addr'], ''),
            nullIf(SpanAttributes['http.client_ip'], ''),
            nullIf(SpanAttributes['net.peer.ip'], ''),
            ''
        ) AS client_address,
        coalesce(
            nullIf(SpanAttributes['user_agent.original'], ''),
            nullIf(SpanAttributes['http.user_agent'], ''),
            ''
        ) AS user_agent,
        coalesce(
            nullIf(SpanAttributes['url.query'], ''),
            if(
                position(SpanAttributes['http.target'], '?') > 0,
                substring(
                    SpanAttributes['http.target'],
                    position(SpanAttributes['http.target'], '?') + 1
                ),
                ''
            )
        ) AS request_query,
        ServiceName AS service,
        ServiceNamespace AS service_namespace,
        ServiceVersion AS service_version,
        Environment AS environment,
        Region AS region,
        ScopeName AS scope_name,
        ScopeVersion AS scope_version,
        toUInt16OrZero(coalesce(
            nullIf(SpanAttributes['http.response.status_code'], ''),
            nullIf(SpanAttributes['http.status_code'], ''),
            nullIf(SpanAttributes['outray.http.response.status_code'], ''),
            '0'
        )) AS status_code,
        StatusCode = 2 OR status_code >= 400 AS is_error,
        StatusMessage AS status_message,
        round(DurationNano / 1000000, 3) AS duration_ms,
        SpanAttributes['outray.http.capture.version'] AS capture_version,
        mapContains(SpanAttributes, 'outray.http.request.headers') AS request_headers_captured,
        if(
            request_headers_captured,
            SpanAttributes['outray.http.request.headers'],
            '{}'
        ) AS request_headers,
        lower(SpanAttributes['outray.http.request.headers.truncated']) IN ('true', '1', 'yes') AS request_headers_truncated,
        mapContains(SpanAttributes, 'outray.http.request.body') AS request_body_captured,
        SpanAttributes['outray.http.request.body'] AS request_body,
        toUInt64OrZero(coalesce(
            nullIf(SpanAttributes['outray.http.request.body.size'], ''),
            nullIf(SpanAttributes['http.request.body.size'], ''),
            nullIf(SpanAttributes['http.request_content_length'], ''),
            '0'
        )) AS request_body_size,
        lower(SpanAttributes['outray.http.request.body.truncated']) IN ('true', '1', 'yes') AS request_body_truncated,
        coalesce(
            nullIf(SpanAttributes['outray.http.request.body.content_type'], ''),
            nullIf(SpanAttributes['http.request.header.content-type'], ''),
            ''
        ) AS request_body_content_type,
        mapContains(SpanAttributes, 'outray.http.response.headers') AS response_headers_captured,
        if(
            response_headers_captured,
            SpanAttributes['outray.http.response.headers'],
            '{}'
        ) AS response_headers,
        lower(SpanAttributes['outray.http.response.headers.truncated']) IN ('true', '1', 'yes') AS response_headers_truncated,
        mapContains(SpanAttributes, 'outray.http.response.body') AS response_body_captured,
        SpanAttributes['outray.http.response.body'] AS response_body,
        toUInt64OrZero(coalesce(
            nullIf(SpanAttributes['outray.http.response.body.size'], ''),
            nullIf(SpanAttributes['http.response.body.size'], ''),
            nullIf(SpanAttributes['http.response_content_length'], ''),
            '0'
        )) AS response_body_size,
        lower(SpanAttributes['outray.http.response.body.truncated']) IN ('true', '1', 'yes') AS response_body_truncated,
        coalesce(
            nullIf(SpanAttributes['outray.http.response.body.content_type'], ''),
            nullIf(SpanAttributes['http.response.header.content-type'], ''),
            ''
        ) AS response_body_content_type,
        request_headers_captured
            OR request_body_captured
            OR response_headers_captured
            OR response_body_captured AS has_capture,
        positionCaseInsensitive(
            concat(request_headers, request_body, response_headers, response_body),
            '[REDACTED]'
        ) > 0
            OR positionCaseInsensitive(
                concat(request_headers, request_body, response_headers, response_body),
                '%5BREDACTED%5D'
            ) > 0 AS has_redaction,
        multiIf(
            not has_capture, 'metadata',
            has_redaction, 'redacted',
            'full'
        ) AS capture_state,
        SpanAttributes AS attributes,
        ResourceAttributes AS resource_attributes,
        ScopeAttributes AS scope_attributes,
        Events AS events,
        Links AS links
    FROM otel_spans FINAL
    WHERE OrganizationId = {{String(organization_id)}}
      AND TraceId = arrayElement(splitByChar(':', {{String(request_id)}}), 1)
      AND SpanId = arrayElement(splitByChar(':', {{String(request_id)}}), 2)
      AND SpanKind = 2

NODE server_requests
SQL >
    %
    SELECT *
    FROM http_spans
    WHERE notEmpty(method)
      AND method != 'EVENT'

NODE request_detail
SQL >
    %
    SELECT *
    FROM server_requests
    WHERE id = {{String(request_id)}}
    ORDER BY timestamp DESC, trace_id DESC, span_id DESC
    LIMIT 1

TYPE endpoint
