TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Organization-wide sparse HTTP/protocol buckets with explicit HTTP error counts.

NODE activity
SQL >
    %
    SELECT toDateTime64(intDiv(toUnixTimestamp(timestamp), least(greatest({{UInt32(bucket_seconds)}}, 1), 86400)) * least(greatest({{UInt32(bucket_seconds)}}, 1), 86400), 3, 'UTC') AS time,
           count() AS http_requests, 0 AS protocol_events,
           countIf(status_code >= 400) AS errors,
           sum(bytes_in + bytes_out) AS http_bytes, 0 AS protocol_bytes
    FROM tunnel_events FINAL
    WHERE organization_id = {{String(organization_id)}}
      AND timestamp >= parseDateTime64BestEffort({{String(start)}}, 3, 'UTC')
      AND timestamp < parseDateTime64BestEffort({{String(end)}}, 3, 'UTC')
      AND timestamp >= now64(3, 'UTC') - toIntervalDay(least(greatest(retention_days, 1), 90))
    GROUP BY time
    UNION ALL
    SELECT toDateTime64(intDiv(toUnixTimestamp(timestamp), least(greatest({{UInt32(bucket_seconds)}}, 1), 86400)) * least(greatest({{UInt32(bucket_seconds)}}, 1), 86400), 3, 'UTC') AS time,
           0 AS http_requests, count() AS protocol_events, 0 AS errors,
           0 AS http_bytes, sum(bytes_in + bytes_out) AS protocol_bytes
    FROM tunnel_protocol_events FINAL
    WHERE organization_id = {{String(organization_id)}}
      AND timestamp >= parseDateTime64BestEffort({{String(start)}}, 3, 'UTC')
      AND timestamp < parseDateTime64BestEffort({{String(end)}}, 3, 'UTC')
      AND timestamp >= now64(3, 'UTC') - toIntervalDay(least(greatest(retention_days, 1), 90))
    GROUP BY time

NODE chart
SQL >
    %
    SELECT time, sum(http_requests) AS http_requests,
           sum(protocol_events) AS protocol_events, sum(errors) AS errors,
           sum(http_bytes) AS http_bytes, sum(protocol_bytes) AS protocol_bytes
    FROM activity
    GROUP BY time
    ORDER BY time ASC

TYPE endpoint

