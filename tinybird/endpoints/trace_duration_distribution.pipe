TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Trace counts grouped into duration buckets for one organization.

NODE duration_rows
SQL >
    %
    SELECT
        TraceId,
        dateDiff('nanosecond', min(Timestamp), max(EndTimestamp)) / 1000000 AS duration_ms
    FROM otel_spans FINAL
    WHERE OrganizationId = {{String(organization_id)}}
      AND Timestamp >= now() - INTERVAL {{Int32(hours, 1)}} HOUR
    GROUP BY TraceId

NODE distribution
SQL >
    SELECT
        multiIf(
            duration_ms < 50, '<50',
            duration_ms < 100, '50-100',
            duration_ms < 250, '100-250',
            duration_ms < 500, '250-500',
            duration_ms < 750, '500-750',
            duration_ms < 1000, '750-1s',
            duration_ms < 2000, '1-2s',
            '>2s'
        ) AS bucket,
        count() AS trace_count
    FROM duration_rows
    GROUP BY bucket

TYPE endpoint
