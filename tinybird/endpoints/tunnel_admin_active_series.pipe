TOKEN OUTRAY_QUERY_TOKEN READ

DESCRIPTION >
    Global snapshot buckets; only server-authenticated administrators may request these.

NODE chart
SQL >
    %
    SELECT toDateTime64(intDiv(toUnixTimestamp(ts), least(greatest({{UInt32(interval_minutes)}}, 1), 1440) * 60) * least(greatest({{UInt32(interval_minutes)}}, 1), 1440) * 60, 3, 'UTC') AS time,
           max(active_tunnels) AS active_tunnels
    FROM tunnel_active_snapshots FINAL
    WHERE ts >= parseDateTime64BestEffort({{String(start)}}, 3, 'UTC')
      AND ts < parseDateTime64BestEffort({{String(end)}}, 3, 'UTC')
      AND ts >= now64(3, 'UTC') - INTERVAL 90 DAY
    GROUP BY time
    ORDER BY time ASC

TYPE endpoint

