{
  "name": "@outray/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "unifont": "0.7.4"
  },
  "scripts": {
    "postinstall": "node packages/icons/prepare.mjs",
    "icons:prepare": "node packages/icons/prepare.mjs",
    "icons:test": "node --test packages/icons/*.test.mjs",
    "prebuild": "node packages/icons/prepare.mjs",
    "pretest": "node packages/icons/prepare.mjs",
    "start": "npm run start --workspace=outray-web",
    "self-host:init": "node scripts/self-hosted.mjs init",
    "self-host:check": "node scripts/self-hosted.mjs check",
    "self-host:up": "node scripts/self-hosted.mjs up",
    "self-host:test": "node --test scripts/self-hosted*.test.mjs deploy/self-hosted/packaging.test.mjs",
    "dev": "dotenv -e .env -- node scripts/with-tinybird.mjs turbo run dev --env-mode=loose --filter='./apps/*' --filter='!outray' --filter='!outray-website'",
    "dev:website": "npm run dev:web",
    "dev:status": "dotenv -e .env -- turbo run dev --env-mode=loose --filter=outray-status",
    "dev:secrets-share": "dotenv -e .env -- turbo run dev --env-mode=loose --filter=outray-secrets-share",
    "dev:uptime-probe": "dotenv -e .env -- turbo run dev --env-mode=loose --filter=outray-uptime-probe",
    "dev:web": "dotenv -e .env -- node scripts/with-tinybird.mjs turbo run dev --env-mode=loose --filter=outray-web",
    "dev:tunnel": "dotenv -e .env -- turbo run dev --env-mode=loose --filter=outray-tunnel",
    "dev:cron": "dotenv -e .env -- node scripts/with-tinybird.mjs turbo run dev --env-mode=loose --filter=outray-cron",
    "dev:internal-check": "dotenv -e .env -- turbo run dev --env-mode=loose --filter=outray-internal-check",
    "dev:ingest": "dotenv -e .env -- node scripts/with-tinybird.mjs turbo run dev --env-mode=loose --filter=outray-ingest",
    "seed:dev": "dotenv -e .env -- node scripts/with-tinybird.mjs node scripts/seed-development.mjs",
    "seed:load:10k": "dotenv -e .env -- node scripts/seed-load-users.mjs",
    "seed:load:otel": "dotenv -e .env -- node scripts/with-tinybird.mjs node scripts/seed-tinybird-load.mjs",
    "seed:uptime:dev": "dotenv -e .env -- node scripts/seed-uptime-development.mjs",
    "seed:secrets:dev": "tsx scripts/seed-secrets-development.mjs",
    "load:k6": "k6 run load/k6/outray-rehearsal.js",
    "load:k6:smoke": "K6_PROFILE=smoke k6 run load/k6/outray-rehearsal.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "dotenv -e .env -- npm run db:migrate --workspace=outray-web",
    "db:migrate:ci": "npm run db:migrate:ci --workspace=outray-web",
    "db:generate-auth": "dotenv -e .env -- npm run db:generate-auth --workspace=outray-web",
    "tokens:backfill": "dotenv -e .env -- npm run tokens:backfill --workspace=outray-web",
    "secrets:rewrap": "dotenv -e .env -- npm run secrets:rewrap --workspace=outray-web --",
    "secrets:rewrap:verify": "dotenv -e .env -- npm run secrets:rewrap:verify --workspace=outray-web --"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.6"
  }
}
