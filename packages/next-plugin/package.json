{
  "name": "@outray/next",
  "version": "0.0.7",
  "description": "Next.js tunnels and OpenTelemetry observability for OutRay",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.mjs",
      "require": "./dist/observability.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "next",
    "nextjs",
    "next-plugin",
    "tunnel",
    "outray",
    "ngrok",
    "localhost",
    "development",
    "observability",
    "opentelemetry",
    "tracing",
    "metrics"
  ],
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@outray/core": "^0.0.5",
    "@outray/observability": "^0.1.4"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.0.0",
    "next": "^16.0.0",
    "tsx": "^4.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "author": "akinloluwami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akinloluwami/outray.git",
    "directory": "packages/next-plugin"
  },
  "homepage": "https://outray.dev/nextjs"
}
