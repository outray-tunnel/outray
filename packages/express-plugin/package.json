{
  "name": "@outray/express",
  "version": "0.0.5",
  "description": "Express tunnels and OpenTelemetry observability for OutRay",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "express",
    "express-middleware",
    "tunnel",
    "outray",
    "ngrok",
    "localhost",
    "development",
    "observability",
    "opentelemetry",
    "tracing",
    "metrics"
  ],
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@outray/core": "^0.0.5",
    "@outray/observability": "^0.1.4"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "express": "^4.19.2",
    "tsx": "^4.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "author": "akinloluwami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/outray-tunnel/outray.git",
    "directory": "packages/express-plugin"
  }
}
